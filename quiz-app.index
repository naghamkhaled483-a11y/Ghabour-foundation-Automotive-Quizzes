<!DOCTYPE html>
<html lang="en" dir="ltr">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Automotive Quizzes</title>
<style id="css">
:root{box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px);--bg:#eef4ff;--card:#fff;--tx:#0f1b3d;--mut:#5b6b8c;--pri:#1d4ed8;--pt:#fff;--acc:#38bdf8;--navy:#0b1f4d;--ok:#15803d;--okb:#dcfce7;--bad:#b91c1c;--badb:#fee2e2;--bd:#d3e0f7;color-scheme:light}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]){--bg:#0a1228;--card:#12204a;--tx:#eaf0ff;--mut:#9fb1d6;--pri:#60a5fa;--pt:#071029;--acc:#7dd3fc;--navy:#050b1f;--ok:#4ade80;--okb:#12301d;--bad:#f87171;--badb:#3a1618;--bd:#23386b;color-scheme:dark}}
:root[data-theme="dark"]{--bg:#0a1228;--card:#12204a;--tx:#eaf0ff;--mut:#9fb1d6;--pri:#60a5fa;--pt:#071029;--acc:#7dd3fc;--navy:#050b1f;--ok:#4ade80;--okb:#12301d;--bad:#f87171;--badb:#3a1618;--bd:#23386b;color-scheme:dark}
*{box-sizing:border-box}
body{margin:0;background:var(--bg);color:var(--tx);font-family:"Segoe UI",Tahoma,"Noto Naskh Arabic",Arial,sans-serif;line-height:1.7}
#root{max-width:680px;margin:0 auto;padding:16px}
header{position:relative;display:flex;align-items:center;justify-content:space-between;gap:8px;margin-bottom:26px;flex-wrap:wrap;background:linear-gradient(135deg,var(--navy),#1e40af);color:#fff;border-radius:18px;padding:16px 18px;box-shadow:0 6px 16px rgba(11,31,77,.3)}
header::after{content:"";position:absolute;left:18px;right:18px;bottom:-11px;height:5px;border-radius:3px;background:repeating-linear-gradient(90deg,#60a5fa 0 20px,transparent 20px 36px)}
header .muted{color:#cbd5e1}
header button{background:rgba(255,255,255,.14);color:#fff;border-color:rgba(255,255,255,.3)}
h1{font-size:1.3rem;margin:0}h2{font-size:1.1rem;margin:18px 0 8px}
button{font:inherit;cursor:pointer;border-radius:12px;border:1px solid var(--bd);background:var(--card);color:var(--tx);padding:8px 14px;transition:transform .12s,box-shadow .12s}
button:hover:not(:disabled){transform:translateY(-1px);box-shadow:0 4px 10px rgba(0,0,0,.12)}
button.pri{background:var(--pri);color:var(--pt);border-color:var(--pri);font-weight:600}
button.danger{color:var(--bad)}
button:disabled{opacity:.55;cursor:default}
.o:disabled{opacity:.95}
a.btn{display:inline-block;text-decoration:none;border-radius:12px;padding:10px 16px;background:#22a45d;color:#fff;font-weight:600}
.card{display:flex;width:100%;justify-content:space-between;align-items:center;text-align:start;padding:14px 16px;margin-bottom:10px;font-size:1.05rem;border-inline-start:7px solid var(--pri);box-shadow:0 2px 6px rgba(0,0,0,.06)}
.card:nth-of-type(3n+2){border-inline-start-color:var(--acc)}
.card:nth-of-type(3n){border-inline-start-color:#93c5fd}
.card small{color:var(--mut);white-space:nowrap;margin-inline-start:10px}
.ic{display:inline-block;font-size:1.5rem;margin-inline-end:8px;vertical-align:middle}
.box{background:var(--card);border:1px solid var(--bd);border-radius:16px;padding:14px;margin-bottom:12px;box-shadow:0 2px 6px rgba(0,0,0,.05)}
.row{display:flex;gap:8px;align-items:center;margin-bottom:8px;flex-wrap:wrap}
.row input{flex:1;min-width:140px}
input,textarea{font:inherit;width:100%;padding:10px 12px;border-radius:12px;border:1px solid var(--bd);background:var(--bg);color:var(--tx)}
input:focus,textarea:focus{outline:2px solid var(--pri);outline-offset:1px}
textarea{min-height:80px}
label{display:block;margin:10px 0 4px;color:var(--mut);font-size:.9rem}
.bar{display:flex;justify-content:space-between;align-items:center;gap:8px;background:var(--card);border:1px solid var(--bd);border-radius:12px;padding:8px 12px;margin-bottom:12px;flex-wrap:wrap}
.msg{background:var(--okb);color:var(--ok);padding:8px 12px;border-radius:10px;margin-bottom:12px}
.err{background:var(--badb);color:var(--bad)}
.muted{color:var(--mut)}
.prog{position:relative;height:32px;background:#3a3f4b;border-radius:16px;overflow:hidden;margin:8px 0 16px}
.prog::before{content:"";position:absolute;left:10px;right:34px;top:15px;height:3px;background:repeating-linear-gradient(90deg,#fff 0 14px,transparent 14px 28px);opacity:.7}
.car{position:absolute;top:0;font-size:22px;line-height:32px;transition:left .45s ease;transform:scaleX(-1)}
.flag{position:absolute;right:8px;top:0;font-size:20px;line-height:32px}
.q{font-size:1.15rem;font-weight:600;margin-bottom:12px}
.o{display:block;width:100%;text-align:start;margin-bottom:8px;padding:12px 14px;border-width:2px}
.o.ok{background:var(--okb);border-color:var(--ok);color:var(--ok)}
.o.bad{background:var(--badb);border-color:var(--bad);color:var(--bad)}
.why{margin:10px 0;padding:10px 12px;border-radius:12px;background:var(--bg);border:1px dashed var(--pri)}
.score{font-size:2.2rem;font-weight:700;text-align:center;margin:0}
.gauge{display:block;margin:0 auto;width:240px;max-width:100%}
.chk{height:16px;border-radius:5px;margin-bottom:14px;background:repeating-conic-gradient(#111 0 25%,#fff 0 50%) 0 0/16px 16px;border:1px solid var(--bd)}
.hero{font-size:2rem;text-align:center;letter-spacing:6px;margin:4px 0 10px}
.opt{display:flex;gap:8px;align-items:center;margin-bottom:6px}.opt input[type=radio]{width:auto}
pre{white-space:pre-wrap;background:var(--bg);padding:8px;border-radius:8px;font-size:.85rem}
.login{margin-top:6px}
.qimg{display:block;max-width:100%;max-height:260px;margin:0 auto 14px;border-radius:10px;background:#fff;border:1px solid var(--bd)}
.logos{display:flex;align-items:center;justify-content:center;gap:16px;background:#fff;border-radius:16px;padding:8px 12px;margin-bottom:14px;box-shadow:0 2px 8px rgba(0,0,0,.08)}
.logos img{height:58px;width:auto;max-width:30%;object-fit:contain;border-radius:8px}
.tl{margin-top:26px;text-align:center}
.tl button{border:none;background:none;color:var(--mut);font-size:.85rem;text-decoration:underline;box-shadow:none}
</style>
</head>
<body>
<div id="root"></div>
<script type="application/json" id="data">{"title": "Automotive Quizzes", "pin": "3112", "phone": "", "subjects": [{"id": "s1", "name": "Metal processing", "lessons": [{"id": "l1", "name": "Safety and Health Concerns", "questions": [{"id": "q1", "q": "Chronic effects of dangerous substances become apparent over a short period.", "opts": ["True", "False"], "a": 1, "why": "Chronic effects appear after long or repeated exposure. Effects that appear quickly are called acute."}, {"id": "q2", "q": "All of the following are dangerous substance labels EXCEPT:", "opts": ["Flammable", "Corrosive", "Toxic", "Recyclable"], "a": 3, "why": "Flammable, corrosive and toxic are hazard labels. Recyclable is not a danger label."}, {"id": "q3", "q": "The color of the mandatory safety sign is:", "opts": ["Yellow", "Green", "Blue", "Black"], "a": 2, "why": "Mandatory signs (for example, wear eye protection) are blue."}, {"id": "q4", "q": "The color of the warning safety sign is:", "opts": ["Green", "Yellow", "Blue", "Black"], "a": 1, "why": "Warning signs are yellow."}, {"id": "q5", "q": "The color of the fire regulation safety sign is purple.", "opts": ["True", "False"], "a": 1, "why": "Fire equipment and fire regulation signs are red, not purple."}, {"id": "q6", "q": "Which of the following is NOT personal protective equipment (PPE)?", "opts": ["Safety glasses", "Work gloves", "Safety shoes", "Fire extinguisher"], "a": 3, "why": "A fire extinguisher is firefighting equipment. PPE is worn by the person."}, {"id": "q7", "q": "What do you call the service technician\u2019s protective head cover?", "opts": ["Cap", "Hat", "Helmet", "Bump cap"], "a": 3, "why": "A bump cap protects the head from bumps when working under vehicles."}, {"id": "q8", "q": "When washing hands, the water should be at what temperature?", "opts": ["77 \u00b0C", "110 \u00b0C", "43 \u00b0C", "43 \u00b0F"], "a": 2, "why": "Warm water of about 43 \u00b0C (110 \u00b0F) is recommended. 77 \u00b0C would scald."}, {"id": "q9", "q": "Hearing protection should be worn anytime the noise level exceeds:", "opts": ["110 dB", "60 dB", "90 dB", "90 \u00b0F"], "a": 2, "why": "Hearing protection is required above 90 dB. Temperature units such as \u00b0F do not measure noise."}, {"id": "q10", "q": "Two technicians are discussing the safe use of a wrench. Technician A says that a wrench should be pulled toward you. Technician B says that a wrench should be pushed away from you. Which technician is correct?", "opts": ["Technician A only", "Technician B only", "Both A and B"], "a": 0, "why": "Pull a wrench toward you. If a pushed wrench slips, your hand can hit the vehicle."}, {"id": "q11", "q": "Exhaust hoses should be used because of one of the exhaust gases. This gas is:", "opts": ["CO", "CO\u2082", "H\u2082O", "N\u2082"], "a": 0, "why": "Carbon monoxide (CO) is a poisonous, colorless, odorless gas."}, {"id": "q12", "q": "Unsafe acts are direct causes of accidents.", "opts": ["True", "False"], "a": 0, "why": "Unsafe acts, such as ignoring rules, are direct causes of accidents."}, {"id": "q13", "q": "Social and work pressure are indirect causes of accidents.", "opts": ["True", "False"], "a": 0, "why": "Pressure can push people into unsafe acts, so it is an indirect cause."}, {"id": "q14", "q": "Wood fire: which fire class and extinguisher are correct?", "opts": ["Class B - foam only", "Class A - water", "Class C - dry powder for metals", "Class D - CO\u2082 only"], "a": 1, "why": "Wood is an ordinary combustible, so it is a Class A fire. Water (or ABC dry chemical) is used."}, {"id": "q15", "q": "Petrol fire: which fire class and extinguisher are correct?", "opts": ["Class A - water", "Class D - dry powder for metals", "Class C - water", "Class B - foam, CO\u2082 or dry chemical"], "a": 3, "why": "Petrol is a flammable liquid, so it is a Class B fire. Never use water on it."}, {"id": "q16", "q": "Electrical fire: which fire class and extinguisher are correct?", "opts": ["Class A - water", "Class B - foam", "Class C - CO\u2082 or dry chemical", "Class D - water"], "a": 2, "why": "Electrical fires are Class C. Use non-conductive agents such as CO\u2082 or dry chemical, never water."}, {"id": "q17", "q": "Cloth fire: which fire class and extinguisher are correct?", "opts": ["Class D - dry powder for metals", "Class B - foam", "Class C - CO\u2082 only", "Class A - water"], "a": 3, "why": "Cloth is an ordinary combustible, so it is a Class A fire."}, {"id": "q18", "q": "Sodium fire: which fire class and extinguisher are correct?", "opts": ["Class A - water", "Class B - foam", "Class C - CO\u2082", "Class D - dry powder for metals"], "a": 3, "why": "Sodium is a combustible metal, so it is a Class D fire. Water makes it much worse."}, {"id": "q19", "q": "A fire blanket is used for warming cold workers.", "opts": ["True", "False"], "a": 1, "why": "A fire blanket is used to smother small fires or wrap a person whose clothes are on fire."}, {"id": "q20", "q": "Which item is usually NOT included in a first aid kit?", "opts": ["Eye wash solution", "Fire blanket", "Antibiotic cream", "Bandages"], "a": 1, "why": "A fire blanket is firefighting equipment and is kept separately."}, {"id": "q21", "q": "An eye wash station should be centrally located.", "opts": ["True", "False"], "a": 0, "why": "It must be easy to reach quickly from anywhere in the workshop."}]}, {"id": "9yqqylt", "name": "Drilling and related operations", "questions": [{"id": "d1", "q": "A hand drill is the first choice for making a hole in a steel block.", "opts": ["True", "False"], "a": 1, "why": "A hand drill lacks the power and rigidity for steel. A drilling machine is used."}, {"id": "d2", "q": "An upright drilling machine is used for drilling small holes.", "opts": ["True", "False"], "a": 1, "why": "Upright drilling machines handle medium to large holes. Small holes are drilled on a sensitive drilling machine."}, {"id": "d3", "q": "A sensitive drilling machine is the perfect choice in watches and jewelry manufacturing.", "opts": ["True", "False"], "a": 0, "why": "It is built for very small, delicate holes, and the operator feels the feed by hand."}, {"id": "d4", "q": "A multi-spindle drilling machine can make more than one hole at once.", "opts": ["True", "False"], "a": 0, "why": "Several spindles work together, so many holes are drilled in one stroke."}, {"id": "d5", "q": "A twist drill is made from mild steel.", "opts": ["True", "False"], "a": 1, "why": "Twist drills are made from H.S.S (high speed steel), which is hard and heat resistant."}, {"id": "d6", "q": "A twist drill with a straight shank can be fixed directly on the spindle.", "opts": ["True", "False"], "a": 1, "why": "A straight shank must be held in a chuck. Only taper shanks fit the spindle directly."}, {"id": "d7", "q": "A twist drill with a straight shank needs a Morse taper chuck to fit on the spindle.", "opts": ["True", "False"], "a": 0, "why": "The chuck holds the straight shank and its Morse taper fits the spindle."}, {"id": "d8", "q": "The heat generated during drilling is useful.", "opts": ["True", "False"], "a": 1, "why": "Heat softens the cutting edge and wears the drill, so coolant is used."}, {"id": "d9", "q": "Conventional cooling is used for cooling when producing large holes.", "opts": ["True", "False"], "a": 1, "why": "Large holes need the coolant to reach the cutting edge through the drill, which is internal cooling."}, {"id": "d10", "q": "In internal cooling, the lubricant coolant flows into internal tunnels in the drill.", "opts": ["True", "False"], "a": 0, "why": "The coolant is pumped through channels inside the drill to the cutting edge."}, {"id": "d11", "q": "Reamer flutes may be straight or helical.", "opts": ["True", "False"], "a": 0, "why": "Both straight-fluted and helical-fluted reamers are used."}, {"id": "d12", "q": "Countersinking and counterboring are similar in steps, except for the cone-shape step.", "opts": ["True", "False"], "a": 0, "why": "Both make a recess for a screw head. Countersinking ends in a cone, counterboring in a flat step."}, {"id": "d13", "q": "Tapping is the process of making an internal thread in an existing hole.", "opts": ["True", "False"], "a": 0, "why": "A tap cuts the thread inside a pre-drilled hole."}, {"id": "d14", "q": "A 3-in-1 tap is used for making internal threads in blind holes and through holes.", "opts": ["True", "False"], "a": 1, "why": "A 3-in-1 tap is only suitable for through holes. Blind holes need a set of three separate taps."}, {"id": "d15", "q": "The distance between the teeth is small in a coarse thread.", "opts": ["True", "False"], "a": 1, "why": "A coarse thread has a large pitch, so the teeth are far apart."}, {"id": "d16", "q": "A rivet is made from H.S.S.", "opts": ["True", "False"], "a": 1, "why": "Rivets are made from soft, ductile metals such as mild steel, so the tail can be formed into a head."}, {"id": "d17", "q": "Side pitch in riveting is the distance between the centerlines of two holes in the same row.", "opts": ["True", "False"], "a": 1, "why": "That is the pitch. Side (back) pitch is the distance between two rows."}, {"id": "d18", "q": "A lap joint means that the two plates are overlapping.", "opts": ["True", "False"], "a": 0, "why": "In a lap joint the plates overlap and the rivets pass through both."}, {"id": "d19", "q": "Cold riveting is tighter than hot riveting.", "opts": ["True", "False"], "a": 1, "why": "In hot riveting the rivet shrinks as it cools and pulls the plates together tightly."}, {"id": "d20", "q": "A butt joint has two types: single strap butt joint and double strap butt joint.", "opts": ["True", "False"], "a": 0, "why": "Butt joints use one or two cover plates (straps)."}, {"id": "d21", "q": "A radial drilling machine can make holes with different:", "opts": ["Sizes", "Sizes and angles", "Frames", "Lengths"], "a": 1, "why": "The swinging arm and tilting head let it drill holes of different sizes and at different angles."}, {"id": "d22", "q": "To make an internal thread M8 you should select a twist drill with a diameter of (mm):", "opts": ["10", "10.5", "8", "6.5"], "a": 3, "why": "Tap drill = thread diameter \u2212 pitch. For M8 \u00d7 1.5 that is 8 \u2212 1.5 = 6.5 mm."}, {"id": "d23", "q": "Counterboring is a process to make a place for a ........ head bolt.", "opts": ["Straight", "Cone", "Taper", "Chamfer"], "a": 0, "why": "Counterboring makes a flat-bottomed recess for a straight (cylindrical) bolt head."}, {"id": "d24", "q": "A twist drill is made from:", "opts": ["Mild steel", "Aluminum", "Brass", "H.S.S"], "a": 3, "why": "H.S.S (high speed steel) is hard and keeps its edge when hot."}, {"id": "d25", "q": "To hold a round bar during the drilling process we use a:", "opts": ["Clamping set", "Vee block", "Anvil", "Vice"], "a": 1, "why": "A Vee block cradles round bars so they stay centered and do not roll."}, {"id": "d26", "q": "A reamer is used for:", "opts": ["Drilling", "Tapping", "Finishing", "Threading"], "a": 2, "why": "A reamer finishes an existing hole to an accurate size with a smooth surface."}, {"id": "d27", "q": "In M8 \u00d7 1.5, the number 1.5 refers to the:", "opts": ["Length", "Width", "Pitch", "Depth"], "a": 2, "why": "1.5 is the thread pitch in millimeters."}, {"id": "d28", "q": "A crossed (staggered) arrangement of rivets is called:", "opts": ["Straight", "Circular", "Single", "Zigzag"], "a": 3, "why": "Rivets in alternating, staggered rows form a zigzag arrangement."}, {"id": "d29", "q": "An upright drilling machine can drill holes up to a diameter of:", "opts": ["10 mm", "50 mm", "15 mm", "30 mm"], "a": 1, "why": "Upright drilling machines handle holes up to about 50 mm."}, {"id": "d30", "q": "Which drilling machine has an arm that swings around a column so the spindle can be positioned over large, heavy workpieces?", "opts": ["Hand drill", "Sensitive drilling machine", "Radial drilling machine", "Multi-spindle drilling machine"], "a": 2, "why": "The radial arm swings and the head slides along it, so the workpiece does not need to move."}, {"id": "d31", "q": "Which drilling machine has a fixed vertical column and a table, and drills medium-to-large holes?", "opts": ["Sensitive drilling machine", "Hand drill", "Lathe", "Upright drilling machine"], "a": 3, "why": "The upright (pillar) drilling machine is the standard workshop machine for medium and large holes."}, {"id": "d32", "q": "Which operation enlarges an existing hole with a single-point cutting tool to correct its size or position?", "opts": ["Reaming", "Boring", "Tapping", "Countersinking"], "a": 1, "why": "Boring uses a single-point tool to enlarge and correct a hole."}, {"id": "d33", "q": "Which operation makes a cone-shaped recess at the mouth of a hole for a flat-head screw?", "opts": ["Boring", "Reaming", "Countersinking", "Counterboring"], "a": 2, "why": "The countersink cutter leaves a conical recess."}, {"id": "d34", "q": "Which operation makes a flat-bottomed cylindrical recess so a bolt head sits below the surface?", "opts": ["Reaming", "Counterboring", "Countersinking", "Tapping"], "a": 1, "why": "Counterboring leaves a flat-bottomed step for a straight bolt head."}, {"id": "d35", "q": "Which statement about twist drill shanks is correct?", "opts": ["Both types must be held in a chuck", "Both types are fixed by welding", "Taper-shank drills fit directly into the spindle, while straight-shank drills are held in a chuck", "Straight-shank drills fit directly into the spindle, while taper-shank drills are held in a chuck"], "a": 2, "why": "Straight shanks are held in a chuck. Taper shanks (Morse taper) fit the spindle directly."}, {"id": "d36", "q": "Which is the correct order of the drilling steps?", "opts": ["Drill the hole \u2192 clamp the workpiece \u2192 mark the position \u2192 fit the drill", "Clamp the workpiece \u2192 drill the hole \u2192 center-punch the position \u2192 fit the drill", "Fit the drill \u2192 drill the hole \u2192 mark the position \u2192 clamp the workpiece", "Mark and center-punch the position \u2192 clamp the workpiece \u2192 fit the drill \u2192 drill the hole with coolant"], "a": 3, "why": "Mark first, then clamp, then fit the drill, then drill."}, {"id": "d37", "q": "In a set of three separate taps, which tap is used last to cut full threads close to the bottom of a blind hole?", "opts": ["Die", "Bottoming (third) tap", "Second tap", "Taper (first) tap"], "a": 1, "why": "The first tap starts the thread, the second continues it, and the bottoming tap finishes it near the bottom."}, {"id": "d38", "q": "Which statement correctly compares tapping and threading?", "opts": ["Tapping cuts an external thread with a die; threading cuts an internal thread with a tap", "Both cut internal threads", "Tapping cuts an internal thread with a tap; threading cuts an external thread with a die", "Both cut external threads using a tap"], "a": 2, "why": "Taps make internal threads in holes. Dies make external threads on rods."}, {"id": "d39", "q": "What is the first step of tapping an M8 thread?", "opts": ["Turn the tap through the hole at full speed", "Ream the hole to 8 mm", "Cut the thread with a die", "Drill the hole using the tap drill size"], "a": 3, "why": "The thread is cut in a pre-drilled hole of the correct tap drill size."}, {"id": "d40", "q": "Before cutting an external thread with a die, the end of the rod should be:", "opts": ["Left square and rough", "Chamfered", "Heated red-hot", "Painted"], "a": 1, "why": "A chamfer helps the die start straight and square."}, {"id": "d41", "q": "While cutting a thread with a die, the die is turned forward and then back slightly to:", "opts": ["Remove the die stock", "Heat the rod", "Make the thread coarser", "Break the chips"], "a": 3, "why": "Backing off breaks the chips so they do not jam the die."}, {"id": "d42", "q": "Riveting is a process of joining plates:", "opts": ["By gluing", "By melting the edges together", "Permanently, using rivets", "Temporarily, using bolts and nuts"], "a": 2, "why": "Rivets make a permanent joint that cannot be undone without destroying the rivet."}, {"id": "d43", "q": "Which of these is a common application of riveting?", "opts": ["Wooden furniture only", "Plastic bag sealing", "Boilers, bridges and aircraft structures", "Paper binding"], "a": 2, "why": "Riveting is used where strong permanent joints are needed in metal structures."}, {"id": "d44", "q": "According to the joint type, riveted joints are classified as:", "opts": ["Hot and cold joints", "Straight and taper joints", "Single and zigzag joints", "Lap joint and butt joint"], "a": 3, "why": "Lap joints overlap the plates. Butt joints place them edge to edge with cover plates."}, {"id": "d45", "q": "According to the method, riveting is classified as:", "opts": ["Hot riveting and cold riveting", "Lap riveting and butt riveting", "Single and double riveting", "Straight and zigzag riveting"], "a": 0, "why": "Hot riveting heats the rivet before heading. Cold riveting does not."}, {"id": "d46", "q": "Which riveting method produces a tighter joint, and why?", "opts": ["Hot riveting, because the rivet shrinks as it cools and pulls the plates together", "Cold riveting, because the rivet is softer", "Cold riveting, because the rivet expands after hammering", "Both give exactly the same tightness"], "a": 0, "why": "Shrinkage of the cooling hot rivet clamps the plates tightly."}, {"id": "d47", "q": "In a butt joint, the two plates are:", "opts": ["Rolled together into a tube", "Placed edge to edge and joined with one or two cover plates (straps)", "Overlapped on top of each other", "Placed at right angles and welded"], "a": 1, "why": "The plates meet edge to edge and the cover plates carry the rivets."}, {"id": "d48", "q": "A double riveted lap joint has:", "opts": ["Rivets in one line only", "Two rows of rivets", "A single cover plate", "One row of rivets"], "a": 1, "why": "Single = one row, double = two rows."}, {"id": "d49", "q": "In a zigzag riveted joint, the rivets in adjacent rows are:", "opts": ["Replaced by bolts", "Placed directly in line", "Placed in one row only", "Staggered (not in line with each other)"], "a": 3, "why": "Zigzag means the rivets alternate between rows."}, {"id": "d50", "q": "Which is the correct order of the riveting steps?", "opts": ["Drill the holes \u2192 clamp the plates together \u2192 insert the rivet \u2192 support the head with a dolly and form the closing head with a snap", "Form the closing head \u2192 insert the rivet \u2192 drill the holes \u2192 clamp the plates", "Insert the rivet \u2192 drill the holes \u2192 form the closing head \u2192 clamp the plates", "Clamp the plates \u2192 form the head \u2192 drill the holes \u2192 insert the rivet"], "a": 0, "why": "The holes must exist before the rivet goes in, and the closing head is formed last."}, {"id": "d51", "q": "Which drilling-related operation is shown in the figure?", "opts": ["Reaming", "Drilling", "Countersinking", "Counterboring"], "a": 1, "why": "A twist drill cuts a new hole in solid metal.", "img": "img1"}, {"id": "d52", "q": "Which drilling-related operation is shown in the figure?", "opts": ["Boring", "Drilling", "Reaming", "Tapping"], "a": 0, "why": "A single-point boring bar enlarges an existing hole.", "img": "img2"}, {"id": "d53", "q": "Which drilling-related operation is shown in the figure?", "opts": ["Boring", "Drilling", "Tapping", "Reaming"], "a": 3, "why": "A fluted reamer finishes a hole to size.", "img": "img3"}, {"id": "d54", "q": "Which drilling-related operation is shown in the figure?", "opts": ["Tapping", "Boring", "Reaming", "Counterboring"], "a": 0, "why": "The tap cuts an internal thread in the hole.", "img": "img4"}, {"id": "d55", "q": "Which drilling-related operation is shown in the figure?", "opts": ["Boring", "Countersinking", "Counterboring", "Tapping"], "a": 1, "why": "The cone-shaped cutter makes a conical recess.", "img": "img5"}, {"id": "d56", "q": "In the drilling machine figure, what is the part labeled A?", "opts": ["Base", "Drill bit", "Belt guard", "Electric motor"], "a": 0, "why": "The base carries the whole machine and bolts to the floor.", "img": "img6"}, {"id": "d57", "q": "In the drilling machine figure, what is the part labeled B?", "opts": ["Belt guard", "Drill bit", "Column (pillar)", "Electric motor"], "a": 2, "why": "The column supports the table and the head.", "img": "img6"}, {"id": "d58", "q": "In the drilling machine figure, what is the part labeled C?", "opts": ["Column (pillar)", "Belt guard", "Worktable", "Base"], "a": 2, "why": "The table holds the workpiece, usually in a vice.", "img": "img6"}, {"id": "d59", "q": "In the drilling machine figure, what is the part labeled E?", "opts": ["Base", "Worktable", "Chuck", "Electric motor"], "a": 3, "why": "The motor drives the spindle through the belt and pulleys.", "img": "img6"}, {"id": "d60", "q": "In the drilling machine figure, what is the part labeled G?", "opts": ["Chuck", "Drill bit", "Electric motor", "Column (pillar)"], "a": 0, "why": "The chuck holds the drill bit.", "img": "img6"}, {"id": "d61", "q": "In the drilling machine figure, what is the part labeled H?", "opts": ["Drill bit", "Worktable", "Electric motor", "Belt guard"], "a": 0, "why": "The twist drill is the cutting tool.", "img": "img6"}]}, {"id": "5lciajg", "name": "files and filing", "questions": [{"id": "ff1", "q": "The filing process is defined as:", "opts": ["The manual removal of a small amount of metal", "The machine cutting of thick metal plates", "The melting and casting of metal", "The bending of metal sheets"], "a": 0, "why": "Filing is the manual removal of a small amount of metal."}, {"id": "ff2", "q": "What is the purpose of filing?", "opts": ["Joining two metal parts together", "Hardening the surface of the metal", "Smoothing the surface or confirming accurate measurements", "Painting the workpiece"], "a": 2, "why": "Filing is used to smooth a surface or to bring the work to accurate measurements."}, {"id": "ff3", "q": "Which of the following is NOT a factor affecting the choice of a file?", "opts": ["The type of material (its hardness)", "The thickness of the layer to be removed", "The shape of the surface to be filed", "The colour of the file handle"], "a": 3, "why": "The factors are material hardness, thickness of the layer to remove, shape of the surface and the smoothness required. Handle colour does not matter."}, {"id": "ff4", "q": "Files are classified by the type of teeth and by:", "opts": ["Weight", "Shape", "Price", "Colour"], "a": 1, "why": "Two classification methods are used: type of teeth and shape."}, {"id": "ff5", "q": "Single-cut (single teeth) files are used for soft materials such as:", "opts": ["Tin, zinc, lead and aluminium", "Steel and cast iron", "Bronze and copper", "Hardened tool steel"], "a": 0, "why": "Single teeth files suit soft materials such as tin, zinc, lead and aluminium."}, {"id": "ff6", "q": "Why are double-cut (double teeth) files used?", "opts": ["To give the finest possible finish on soft metals", "To file wood and leather", "To remove chips faster, and for hard metals such as bronze and copper", "To cut internal threads"], "a": 2, "why": "Double teeth files remove chips faster and are used for harder metals like bronze and copper."}, {"id": "ff7", "q": "Rasping teeth files are used for processing:", "opts": ["Hardened steel only", "Wood, hard tissues, leather and the like", "Glass and ceramics", "Cast iron only"], "a": 1, "why": "Rasp files are used for wood, hard tissue and leather, and they can also be used on aluminium."}, {"id": "ff8", "q": "What is the flat file used for?", "opts": ["To level surfaces", "To make circular slots", "To make triangular shapes", "To make conical shapes"], "a": 0, "why": "The flat file is used to level surfaces."}, {"id": "ff9", "q": "Which file is used to obtain square slots?", "opts": ["Round file", "Flat file", "Triangular file", "Square file"], "a": 3, "why": "The square file is used to obtain square slots."}, {"id": "ff10", "q": "What is the round file used for?", "opts": ["To obtain square slots", "To obtain circular slots", "To level surfaces", "To obtain triangular shapes"], "a": 1, "why": "The round file is used to obtain circular slots."}, {"id": "ff11", "q": "Which file is used to obtain triangular shapes?", "opts": ["Square file", "Round file", "Triangular file", "Flat file"], "a": 2, "why": "The triangular file is used to obtain triangular shapes."}, {"id": "ff12", "q": "What is the half-round file used for?", "opts": ["To get conical shapes", "To level flat surfaces", "To obtain square slots", "To stamp numbers"], "a": 0, "why": "The slides state that the half-round file is used to get conical shapes."}, {"id": "ff13", "q": "When filing aluminium and lead, which type of file is used?", "opts": ["Double-cut files", "Rasp files only", "No file can be used", "Single-cut files"], "a": 3, "why": "For soft metals like aluminium and lead, single-cut files are used."}, {"id": "ff14", "q": "When filing solid metals such as steel and cast iron, which type of file is used?", "opts": ["Double-cut files", "Single-cut files", "Wooden files", "Rasp files"], "a": 0, "why": "Hard metals such as steel and cast iron are filed with double-cut files."}, {"id": "ff15", "q": "Filing methods are divided into two main types:", "opts": ["Fast filing and slow filing", "Hand filing and wet filing", "Flat filing and round filing", "Rough filing and polished filing"], "a": 2, "why": "The two main filing methods are flat filing and round filing."}, {"id": "ff16", "q": "Which of the following is NOT a type of flat filing?", "opts": ["Longitudinal filing", "Accidental (cross) filing", "Slanted filing", "Spiral filing"], "a": 3, "why": "Flat filing has three types: longitudinal, accidental (cross) and slanted."}, {"id": "ff17", "q": "In slanted filing, how is the file moved?", "opts": ["It is pushed straight along the length of the work", "It is pulled sideways to obtain an equal amount of chip", "It is rotated in circles", "It is struck with a hammer"], "a": 1, "why": "In slanted filing the file is pulled sideways so the chip removed is equal."}, {"id": "ff18", "q": "How should the file be held for correct filing?", "opts": ["Handle in the right hand, left-hand fingers on the front end, and thumb on the upper surface", "Both hands on the handle", "Left hand on the handle and right hand on the blade tip", "Only the right hand, with no support at the front"], "a": 0, "why": "The handle is held in the right hand, the left-hand fingers grip the front end, and the thumb rests on top of the file."}, {"id": "ff19", "q": "Why should a file be held properly?", "opts": ["To make the file last forever without cleaning", "To make it cut faster than any machine", "To ensure satisfactory results, avoid injury and reduce effort", "So that no vise is needed"], "a": 2, "why": "Correct holding gives better results, avoids injury and reduces the effort needed."}, {"id": "ff20", "q": "How should chips stuck between the teeth of a file be cleaned?", "opts": ["With a hammer", "With a wire brush", "By tapping the file on the bench", "With water only"], "a": 1, "why": "Chips and foreign material are cleaned from between the teeth with a wire brush."}, {"id": "ff21", "q": "Why should you not knock on files with a hammer or any sharp object?", "opts": ["To preserve the integrity of the file teeth", "To keep the handle clean", "To make the file heavier", "To keep the file magnetic"], "a": 0, "why": "Hitting a file can damage its teeth."}, {"id": "ff22", "q": "What should be done to files before storing them for long periods?", "opts": ["Leave chips on them", "Paint them", "Soak them in water", "Clean them and cover them with a thin layer of oil"], "a": 3, "why": "Files are cleaned before storing and coated with thin oil for long storage."}, {"id": "ff23", "q": "Why should files not be stacked in boxes without arrangement?", "opts": ["So they do not rust from the air", "So their delicate teeth are not exposed to breakage", "So they are not lost", "So the handles stay clean"], "a": 1, "why": "Files thrown together can damage each other's delicate teeth."}, {"id": "ff24", "q": "How is the size of a C-clamp determined?", "opts": ["By the largest opening of its jaws", "By its weight", "By the length of its screw handle", "By its colour"], "a": 0, "why": "The size of a C-clamp is given by the largest opening of its jaws."}, {"id": "ff25", "q": "What should you never do to the slide bar of a vise?", "opts": ["Clean it", "Oil it", "Hammer on it", "Look at it"], "a": 2, "why": "Hammering on the slide bar can crack or distort it."}]}, {"id": "rc1bo2g", "name": "Marking out and hand tools", "questions": [{"id": "mk1", "q": "What is defined as the first step in the manufacturing process where a design, layout, or dimensions are transferred from a plan to a workpiece?", "opts": ["Cutting", "Marking out", "Drilling", "Filing"], "a": 1, "why": "Marking out transfers the design, layout or dimensions from the plan onto the workpiece before any cutting or machining."}, {"id": "mk2", "q": "Why are scribers preferred over standard pencils for marking lines on metal workpieces prior to manufacturing?", "opts": ["Pencil marks can rub off easily", "Pencils leave lines that are too thick", "Pencils break easily on hard metals", "Scribers are faster to use"], "a": 0, "why": "Pencil lines rub off easily. A scribed line is permanent and stays visible during work."}, {"id": "mk3", "q": "What is a scriber typically constructed from?", "opts": ["A hollow copper tube", "A rod of steel sharpened to a point at one or both ends", "A rigid plastic wire", "A flat metal blade"], "a": 1, "why": "A scriber is a steel rod sharpened to a point at one or both ends."}, {"id": "mk4", "q": "What is the point angle of a center punch used to create an indent for drilling operations?", "opts": ["45\u00b0", "60\u00b0", "90\u00b0", "120\u00b0"], "a": 2, "why": "A center punch has a 90\u00b0 point, giving an indent large enough to start a drill."}, {"id": "mk5", "q": "What is the primary purpose of a prick punch in layout operations?", "opts": ["To produce a smaller indentation that acts as a useful datum point", "To completely punch through thin metal sheets", "To widen pre-existing drill holes", "To stamp letters onto tools"], "a": 0, "why": "A prick punch makes a small indent used as a datum point on the layout."}, {"id": "mk6", "q": "What is the point angle of a prick punch?", "opts": ["90\u00b0", "60\u00b0", "30\u00b0", "180\u00b0"], "a": 1, "why": "A prick punch has a sharper 60\u00b0 point than a center punch."}, {"id": "mk7", "q": "What are letter stamps or number stamps used for?", "opts": ["To form deep drill indents", "To measure internal diameters", "To print a letter or number into a workpiece", "To scribe circle radiuses"], "a": 2, "why": "Letter and number stamps impress characters into the workpiece."}, {"id": "mk8", "q": "Which of the following is NOT a standard use of an engineer's square as listed in the presentation?", "opts": ["Checking the straightness of a workpiece", "Marking perpendicular lines onto a workpiece", "Scribing large circles and arcs directly", "Checking flatness and inside/outside corners"], "a": 2, "why": "An engineer's square checks corners, straightness and flatness and marks perpendicular lines. Circles and arcs are scribed with dividers."}, {"id": "mk9", "q": "What graduations are usually found on a workshop steel rule?", "opts": ["Centimetres and decimetres", "Millimetres and half millimetres", "Inches and fractions of inches only", "Micrometres and nanometres"], "a": 1, "why": "Workshop steel rules are graduated in millimetres and half millimetres."}, {"id": "mk10", "q": "What material are dividers and calipers usually made from?", "opts": ["Cast iron", "Medium carbon steel", "Pure aluminium", "Brass"], "a": 1, "why": "Dividers and calipers are usually made from medium carbon steel."}, {"id": "mk11", "q": "Which caliper type is used to measure and check external diameters and dimensions during operation?", "opts": ["External caliper", "Internal measurement caliper", "Spring divider", "Odd-leg caliper"], "a": 0, "why": "The external caliper measures outside diameters and dimensions."}, {"id": "mk12", "q": "How is an internal measurement caliper used to obtain internal measurements?", "opts": ["It is pressed tightly from the outside inward", "It enters the place to be measured and opens outward slowly until contact is made with the edges", "It is heated so it expands to fit the gap", "It is clamped using a vise grip"], "a": 1, "why": "The caliper is placed inside the space and opened slowly outward until its legs touch the edges."}, {"id": "mk13", "q": "What are spring dividers used for?", "opts": ["Cutting fine copper wires", "Scribing arcs and circles onto a workpiece", "Measuring deep internal holes", "Checking surface flatness"], "a": 1, "why": "Spring dividers are used to scribe arcs and circles on a workpiece."}, {"id": "mk14", "q": "When marking a straight line along a rule, how should the scriber be inclined?", "opts": ["Inclined away from the straight edge", "Positioned at exactly 90 degrees straight up", "Placed completely flat against the ruler face", "Tilted toward the user's body"], "a": 0, "why": "Tilting the scriber away from the straight edge keeps the point against the rule for an accurate line."}, {"id": "mk15", "q": "What tool is required for scribing larger Pitch Circle Diameters (PCDs) instead of standard dividers?", "opts": ["Center punches", "Trammels", "Engineer's squares", "Odd-leg calipers"], "a": 1, "why": "Trammels are used to scribe circles too large for standard dividers."}, {"id": "mk16", "q": "Why is a dot punch mark used when scribing circles and arcs with dividers?", "opts": ["To lighten the weight of the sheet metal", "To locate the leg of the dividers when scribing", "To cool down the metal plate", "To test metal hardness"], "a": 1, "why": "The punch mark holds the divider leg in place so it does not slip while scribing."}, {"id": "mk17", "q": "What is the flat or stretching hammer used for?", "opts": ["Breaking concrete and heavy masonry", "Stretching edges and flanges on curved work", "Punching holes through thick steel sheets", "Tightening large pipe fittings"], "a": 1, "why": "The flat (stretching) hammer is used to stretch edges and flanges on curved work."}, {"id": "mk18", "q": "Why are boxwood and rubber mallets used on mild steel, copper, or aluminium?", "opts": ["To increase the metal's magnetic properties", "To prevent marring the metal", "To heat up the workpiece during shaping", "Because they are heavier than steel hammers"], "a": 1, "why": "Mallets are softer than the metal, so they shape it without leaving marks."}, {"id": "mk19", "q": "Which cutting tool is designed specifically for straight-line cutting?", "opts": ["Combination snips", "Straight snips", "Hacksaw", "Combination pliers"], "a": 1, "why": "Straight snips have straight blades made for cutting in a straight line."}, {"id": "mk20", "q": "Which snips are used most commonly by the industrial insulator to cut straight, irregular lines, and curves?", "opts": ["Straight snips", "Combination snips (shears)", "Wire-cutting nippers", "Pipe wrenches"], "a": 1, "why": "Combination snips (shears) can cut straight lines, irregular lines and curves."}, {"id": "mk21", "q": "What structural features do combination pliers possess?", "opts": ["Flat jaws grooved to hold work, and sharpened edges to cut light wire", "Circular jaws for pipes and a built-in level", "Adjustable wrench heads and screwdrivers", "Insulated plastic teeth for electronics only"], "a": 0, "why": "Combination pliers have flat grooved jaws for gripping and sharpened edges for cutting light wire."}, {"id": "mk22", "q": "What is the primary purpose of vise grip pliers?", "opts": ["Measuring inner diameters with high precision", "Clamping and locking securely onto workpieces", "Soldering electrical components", "Filing rough metal edges"], "a": 1, "why": "Vise grips lock onto the workpiece and hold it firmly like a small clamp."}, {"id": "mk23", "q": "What is the main purpose of a hacksaw?", "opts": ["Cutting materials by hand", "Sawing through thick timber beams", "Bending metal tubes into angles", "Measuring linear dimensions"], "a": 0, "why": "A hacksaw is a hand tool for cutting metal and other materials."}, {"id": "mk24", "q": "Why must a steel rule be in good condition with flat, straight, and true edges?", "opts": ["To ensure accuracy during measuring", "To prevent the steel from rusting", "So it can bend around curved objects easily", "To make it lighter to carry"], "a": 0, "why": "A damaged or bent rule gives wrong readings, so its edges must be true."}, {"id": "mk25", "q": "When marking hole positions on a Pitch Circle Diameter (PCD), what action follows centering the PCD and scribing the pitch circle?", "opts": ["Paint the entire metal surface black", "Calculate hole positions, use dividers to step-out and scribe positions around the PCD, then center punch and drill", "Immediately cut out the circle with a hacksaw", "Discard the measurement tools"], "a": 1, "why": "After scribing the pitch circle, you calculate the hole spacing, step it out with dividers, scribe the positions, then center punch and drill."}]}, {"id": "8duq6l5", "name": "Measurement instruments", "questions": [{"id": "mi1", "q": "When the reading of a vernier caliper is displayed on an LCD, it is called a:", "opts": ["Digital caliper", "Micrometer", "Dial caliper", "Feeler gauge"], "a": 0, "why": "A caliper that shows its reading on an LCD screen is a digital caliper."}, {"id": "mi2", "q": "In a dial caliper, how is the reading shown?", "opts": ["On an LCD screen", "By a lock screw", "By a pointer on a circular scale", "By a thread on the jaws"], "a": 2, "why": "A dial caliper replaces the vernier scale with a pointer moving over a circular scale."}, {"id": "mi3", "q": "A vernier caliper can be used to measure:", "opts": ["External diameters, internal diameters and depths", "External diameters only", "Gap widths only", "Thread pitch only"], "a": 0, "why": "It has outside jaws, inside jaws and a depth probe, so it is not limited to external diameters."}, {"id": "mi4", "q": "Which part of the vernier caliper is used to measure depth?", "opts": ["Lock screw", "Inside jaws", "Outside jaws", "Depth probe"], "a": 3, "why": "The depth probe slides out of the end of the caliper to measure depths."}, {"id": "mi5", "q": "What is the function of the lock screw on a vernier caliper?", "opts": ["To lock the jaws in position so the reading can be kept", "To measure depth", "To adjust the main scale", "To clean the jaws"], "a": 0, "why": "The lock screw fixes the sliding jaw so the reading does not change."}, {"id": "mi6", "q": "Which of the following is NOT used to measure internal diameters?", "opts": ["Internal micrometer", "Internal micrometer caliper", "Inside jaws of a vernier caliper", "Vernier height gauge"], "a": 3, "why": "The vernier height gauge measures heights, not internal diameters."}, {"id": "mi7", "q": "Which two instruments are used to measure depth dimensions?", "opts": ["Feeler gauge and thread gauge", "Depth micrometer and vernier depth gauge", "Radius gauge and dial gauge", "Internal micrometer and height gauge"], "a": 1, "why": "Both the depth micrometer and the vernier depth gauge measure depths."}, {"id": "mi8", "q": "Which of the following is a part of an outside micrometer?", "opts": ["Thimble", "Depth probe", "Bourdon tube", "Vernier jaws"], "a": 0, "why": "An outside micrometer has a frame, anvil, spindle, sleeve, thimble, lock nut and ratchet."}, {"id": "mi9", "q": "What is the range and graduation of the outside micrometer shown in the presentation?", "opts": ["0\u2013100 mm, 0.1 mm", "0\u201325 mm, 0.01 mm", "0\u201325 mm, 1 mm", "0\u2013150 mm, 0.5 mm"], "a": 1, "why": "The figure is marked 0\u201325 mm with a graduation of 0.01 mm."}, {"id": "mi10", "q": "A dial gauge is used to check:", "opts": ["The pressure of tires", "The pitch of a screw thread", "The flatness of surfaces and the concentricity of round objects", "The radius of a corner"], "a": 2, "why": "The dial gauge checks flatness and concentricity."}, {"id": "mi11", "q": "To check the concentricity of a crankshaft, you will use a:", "opts": ["Dial gauge", "Pressure gauge", "Feeler gauge", "Thread gauge"], "a": 0, "why": "A dial gauge is used to check the concentricity of round objects such as a crankshaft."}, {"id": "mi12", "q": "What is a feeler gauge used for?", "opts": ["Measuring gap widths (clearance) between two objects that are close together", "Measuring the pitch of a thread", "Measuring the radius of a corner", "Measuring air pressure"], "a": 0, "why": "A feeler gauge measures small gaps or clearances."}, {"id": "mi13", "q": "What is a radius gauge used for?", "opts": ["Measuring gap widths", "Measuring the radius of a corner", "Measuring thread pitch", "Checking go and no-go limits"], "a": 1, "why": "A radius gauge is used to measure the radius of a corner."}, {"id": "mi14", "q": "What is a thread gauge used for?", "opts": ["Measuring the clearance between two parts", "Measuring tire pressure", "Measuring the pitch or lead of a screw thread", "Checking concentricity"], "a": 2, "why": "A thread gauge measures the pitch (lead) of a screw thread."}, {"id": "mi15", "q": "You have a steel block with a fillet corner. Which tool will you use to measure the fillet radius?", "opts": ["Radius gauge", "Dial gauge", "Feeler gauge", "Pressure gauge"], "a": 0, "why": "A radius gauge measures the radius of a corner such as a fillet."}, {"id": "mi16", "q": "The Bourdon tube is the basic component of a:", "opts": ["Vernier caliper", "Pressure gauge", "Thread gauge", "Micrometer"], "a": 1, "why": "A Bourdon tube is the working part inside a pressure gauge such as a tire pressure gauge."}, {"id": "mi17", "q": "1 bar is equal to approximately:", "opts": ["14.5 psi", "1.45 psi", "145 psi", "4.15 psi"], "a": 0, "why": "The presentation gives 1 bar = 14.5 psi."}, {"id": "mi18", "q": "Most pressure and vacuum gauges in automotive workshops:", "opts": ["Work using a vernier scale", "Work using feeler blades", "Have the same working principle", "Work only electronically"], "a": 2, "why": "They all work on the same principle as the Bourdon tube gauge."}, {"id": "mi19", "q": "What is the acceptable size range for a dimension of 40 \u00b1 0.25 mm?", "opts": ["39.5 mm to 40.5 mm", "39.75 mm to 40.25 mm", "40.00 mm to 40.25 mm", "39.75 mm to 40.00 mm"], "a": 1, "why": "40 \u2212 0.25 = 39.75 and 40 + 0.25 = 40.25."}, {"id": "mi20", "q": "What are the three types of fits?", "opts": ["Clearance, transition and interference", "Clearance, pressure and thread", "Gap, limit and radius", "Interference, vernier and dial"], "a": 0, "why": "Fits are classified as clearance, transition or interference."}, {"id": "mi21", "q": "When two objects are forced to fit together, it is called a(n):", "opts": ["Clearance fit", "Transition fit", "Limit fit", "Interference fit"], "a": 3, "why": "In an interference fit the parts must be forced together."}, {"id": "mi22", "q": "What type of fit is used between the piston and cylinder in internal combustion engines?", "opts": ["Clearance fit", "Transition fit", "Interference fit", "No fit is used"], "a": 0, "why": "The piston must move freely in the cylinder, so a clearance fit is used."}, {"id": "mi23", "q": "Limit (go and not go) gauges are used to:", "opts": ["Measure the exact size of a component", "Ensure components lie within the permissible limits without determining the actual size", "Measure the pressure inside a tire", "Measure the pitch of a thread"], "a": 1, "why": "Limit gauges only show whether a part is within limits. They do not give the actual dimension."}, {"id": "mi24", "q": "A go/no-go gauge is an inspection tool used to:", "opts": ["Measure gaps between two parts", "Scribe lines on metal", "Check a workpiece against its allowed tolerances", "Measure the depth of blind holes"], "a": 2, "why": "A go/no-go test checks whether a workpiece is within its tolerance limits."}, {"id": "mi25", "q": "Which tool is used to measure angles?", "opts": ["Angle finder ruler", "Feeler gauge", "Thread gauge", "Vernier depth gauge"], "a": 0, "why": "Angle finder rulers (including the digital type) are used to measure angles."}]}, {"id": "p3cwyqb", "name": "sawing+bending +shearing", "questions": [{"id": "sb1", "q": "What is meant by the cutting process?", "opts": ["Detaching parts from each other", "Drilling the sample", "Cleaning the sample from chips", "Transferring dimensions onto the sample"], "a": 0, "why": "Cutting separates parts from each other."}, {"id": "sb2", "q": "Which of the following is NOT one of the basic requirements of the cutting process?", "opts": ["The cut surface should be as flat as possible", "The cutting time should be as short as possible", "The life of the tool should be as long as possible", "Force exerted on the tool should be as large as possible"], "a": 3, "why": "The force exerted on the tool should be as small as possible, not large."}, {"id": "sb3", "q": "One of the basic requirements of the cutting process is that the cutting time should be:", "opts": ["As short as possible", "As long as possible", "Exactly one minute", "Not important"], "a": 0, "why": "The four requirements are a flat cut surface, short cutting time, small force on the tool and long tool life."}, {"id": "sb4", "q": "What types of saws are mentioned in the course?", "opts": ["Hacksaw and pipe wrench", "Hacksaw and automatic saws", "Automatic saws and feeler saws", "Hand saws made of wood only"], "a": 1, "why": "The saws mentioned are the hacksaw and automatic saws."}, {"id": "sb5", "q": "What are saws used for?", "opts": ["To measure the length of workpieces", "To smooth surfaces", "To separate materials or workpieces and to cut grooves or slits", "To bend sheet metal"], "a": 2, "why": "Saws separate materials or workpieces and cut grooves or slits."}, {"id": "sb6", "q": "On what does the tooth spacing of a saw blade depend?", "opts": ["The type of workpiece material", "The colour of the blade", "The length of the handle", "The brand of the saw"], "a": 0, "why": "Tooth spacing is chosen according to the material being cut."}, {"id": "sb7", "q": "What is the main purpose of a hacksaw?", "opts": ["Measuring linear dimensions", "Cutting materials by hand", "Bending metal tubes", "Marking out centre points"], "a": 1, "why": "A hacksaw is a hand tool for cutting."}, {"id": "sb8", "q": "A hacksaw blade is normally fitted so that it cuts on the:", "opts": ["Forward (push) stroke", "Backward (pull) stroke only", "Both strokes equally", "Neither stroke, it only scratches"], "a": 0, "why": "The teeth point away from the handle, so cutting happens on the push stroke and the blade is lifted slightly on the return."}, {"id": "sb9", "q": "Which hacksaw blade is better for cutting thin sheet metal and thin tubes?", "opts": ["A coarse-toothed blade", "A blade with no teeth", "A fine-toothed blade (many teeth per inch)", "A wooden blade"], "a": 2, "why": "Thin material needs fine teeth so that enough teeth are always in contact with it. Coarse teeth suit soft, thick material."}, {"id": "sb10", "q": "When sawing, at least how many teeth should be in contact with the workpiece?", "opts": ["Three", "One", "Two", "None"], "a": 0, "why": "With at least three teeth in contact, the blade does not catch and break teeth."}, {"id": "sb11", "q": "What must you pay attention to when working with sheet metal shears?", "opts": ["Use them without any protection", "Wear gloves and deburr the workpieces", "Work only with wet hands", "Hold the sheet metal by the cut edge"], "a": 1, "why": "Sheet metal is sharp, and cutting creates sharp edges and burrs, so gloves are required and workpieces must be deburred."}, {"id": "sb12", "q": "Why must workpieces be deburred after shearing?", "opts": ["To remove sharp edges and burrs", "To make the workpiece heavier", "To harden the metal", "To change the colour of the metal"], "a": 0, "why": "Burrs are sharp and can cut hands and prevent parts from fitting together."}, {"id": "sb13", "q": "Which cutting tool is designed specifically for straight-line cutting?", "opts": ["Straight snips", "Combination snips", "Hacksaw", "Combination pliers"], "a": 0, "why": "Straight snips cut in straight lines."}, {"id": "sb14", "q": "Which snips can cut straight lines, irregular lines and curves?", "opts": ["Straight snips only", "Combination snips (shears)", "Wire-cutting nippers", "Pipe wrenches"], "a": 1, "why": "Combination snips (shears) can cut straight lines, irregular lines and curves."}, {"id": "sb15", "q": "How does a shearing machine cut sheet metal?", "opts": ["By two opposing blades passing each other", "By melting the metal", "By rotating a drill bit", "By hitting the metal with a hammer"], "a": 0, "why": "Shearing cuts metal between two blades moving past each other, like scissors."}, {"id": "sb16", "q": "If the clearance between shear blades is too large, what is likely to happen?", "opts": ["The cut edge becomes rough with large burrs", "The cut becomes perfectly smooth", "The blades last forever", "The sheet metal becomes harder"], "a": 0, "why": "Too much blade clearance causes rough edges and burrs."}, {"id": "sb17", "q": "What happens to the metal during bending?", "opts": ["Material is removed as chips", "Its shape changes without removing any material", "Parts are separated from each other", "A hole is made in it"], "a": 1, "why": "Bending is a forming process: the metal is permanently deformed, not cut."}, {"id": "sb18", "q": "When a sheet is bent, what happens to the two sides of the bend?", "opts": ["The outside stretches and the inside is compressed", "The outside is compressed and the inside stretches", "Both sides stretch", "Neither side changes"], "a": 0, "why": "The outer surface is in tension and the inner surface is in compression."}, {"id": "sb19", "q": "What is the neutral axis (neutral line) in a bend?", "opts": ["The outer surface of the bend", "The inner surface of the bend", "A line inside the metal that neither stretches nor compresses", "The line where the sheet is cut"], "a": 2, "why": "The neutral axis keeps its original length during bending."}, {"id": "sb20", "q": "What is springback?", "opts": ["The metal partly returning toward its original shape after bending force is removed", "The metal breaking during bending", "The tool bouncing off the metal", "The metal getting hotter"], "a": 0, "why": "Metal is elastic, so it springs back a little, which is why it is often over-bent slightly."}, {"id": "sb21", "q": "What can happen if the bend radius is too small for the material?", "opts": ["The metal becomes softer", "The metal can crack on the outside of the bend", "The metal becomes longer than the drawing", "Nothing at all"], "a": 1, "why": "A very sharp bend stretches the outside too much and can crack it."}, {"id": "sb22", "q": "When bending sheet metal held in a vise, why is a mallet or soft jaws used?", "opts": ["To avoid marring the metal", "To make the metal magnetic", "To heat the metal", "To make the vise heavier"], "a": 0, "why": "Soft tools such as mallets and soft jaws shape or hold the metal without leaving marks."}, {"id": "sb23", "q": "What is the bend allowance?", "opts": ["The thickness of the sheet", "The length of the neutral axis within the bend", "The length of the hacksaw blade", "The clearance between shear blades"], "a": 1, "why": "The bend allowance is the length of metal used up in the bend, measured along the neutral axis."}, {"id": "sb24", "q": "One basic requirement of the cutting process is that the life of the tool should be:", "opts": ["As long as possible", "As short as possible", "Exactly one hour", "Not important"], "a": 0, "why": "Long tool life is one of the four basic requirements."}, {"id": "sb25", "q": "One basic requirement of the cutting process is that the cut surface should be:", "opts": ["As rough as possible", "As flat as possible", "As curved as possible", "As wavy as possible"], "a": 1, "why": "A flat cut surface is one of the four basic requirements."}]}]}, {"id": "829mki9", "name": "Electricity", "lessons": [{"id": "elec_l1", "name": "True or False", "questions": [{"id": "el1", "q": "In case of parallel connection, the current across the resistance is variable.", "opts": ["True", "False"], "a": 0, "why": "In a parallel circuit the total current divides between the branches, so the current through each resistance differs."}, {"id": "el2", "q": "When the length of the conductor increases, the resistance increases.", "opts": ["True", "False"], "a": 0, "why": "Resistance is directly proportional to the length of the conductor."}, {"id": "el3", "q": "Voltage is the flow of electrons through electrical conductors.", "opts": ["True", "False"], "a": 1, "why": "The flow of electrons is current. Voltage is the force (pressure) that causes the current to flow."}, {"id": "el4", "q": "The atom is negatively charged.", "opts": ["True", "False"], "a": 1, "why": "The atom is electrically neutral: the protons and electrons balance each other."}, {"id": "el5", "q": "The unit of the electrical power is joule.", "opts": ["True", "False"], "a": 1, "why": "The unit of electrical power is the watt (W)."}]}, {"id": "elec_l2", "name": "Choose the correct answer", "questions": [{"id": "el6", "q": "An electrical conductor is an element with ____ electrons in its outer orbit.", "opts": ["More than 4", "Less than 2", "Less than 4", "Exactly 4"], "a": 2, "why": "Conductors have fewer than 4 outer electrons, which are loosely held and move easily."}, {"id": "el7", "q": "An electrical insulator is an element with ____ electrons in its outer orbit.", "opts": ["Less than 2", "Less than 4", "Exactly 4", "More than 4"], "a": 3, "why": "Insulators have more than 4 outer electrons that are tightly held, so current cannot flow easily."}, {"id": "el8", "q": "An electrical semiconductor is an element with ____ electrons in its outer orbit.", "opts": ["Less than 2", "Exactly 4", "More than 4", "Less than 4"], "a": 1, "why": "Semiconductors have exactly 4 outer electrons."}, {"id": "el9", "q": "Same charges ____.", "opts": ["Add", "Neutralize each other", "Repel", "Attract"], "a": 2, "why": "Like charges repel each other; unlike charges attract."}, {"id": "el10", "q": "Different charges ____.", "opts": ["Neutralize each other", "Attract", "Repel", "Add"], "a": 1, "why": "Unlike (opposite) charges attract each other."}, {"id": "el11", "q": "Carbon and silicon are examples of ____.", "opts": ["Conductors", "Photoelectric materials", "Semiconductors", "Insulators"], "a": 2, "why": "Carbon and silicon have 4 electrons in the outer orbit, so they are semiconductors."}, {"id": "el12", "q": "Wood and glass are examples of ____.", "opts": ["Semiconductors", "Photoelectric materials", "Conductors", "Insulators"], "a": 3, "why": "Wood and glass do not allow current to flow easily, so they are insulators."}, {"id": "el13", "q": "Copper and aluminum are examples of ____.", "opts": ["Photoelectric materials", "Conductors", "Insulators", "Semiconductors"], "a": 1, "why": "Copper and aluminum allow current to flow easily, so they are conductors."}, {"id": "el14", "q": "What is the unit of electric current in a circuit?", "opts": ["Volt", "Ohm", "Ampere", "Coulomb"], "a": 2, "why": "Current is measured in amperes (A); volt measures voltage and ohm measures resistance."}, {"id": "el15", "q": "If 12 volts are applied to a resistance of 4 ohms, ____ amperes will flow.", "opts": ["12", "36", "4", "3"], "a": 3, "why": "I = V / R = 12 / 4 = 3 A."}, {"id": "el16", "q": "How many watts are consumed by a starter motor if it draws 150 A at 10 V?", "opts": ["15,000 watts", "1,500 watts", "15 watts", "150 watts"], "a": 1, "why": "P = V \u00d7 I = 10 \u00d7 150 = 1,500 W."}, {"id": "el17", "q": "The source of voltage in the electric circuit is the ____.", "opts": ["Switch", "Wires", "Resistance", "Battery"], "a": 3, "why": "The battery provides the voltage that drives the current."}, {"id": "el18", "q": "Current that moves in one direction in a conductor is ____.", "opts": ["None of these", "EC", "DC", "AC"], "a": 2, "why": "Direct current (DC) flows in one direction only."}, {"id": "el19", "q": "Current that moves in both directions in a conductor is ____.", "opts": ["DC", "None of these", "AC", "EC"], "a": 2, "why": "Alternating current (AC) changes direction back and forth."}, {"id": "el20", "q": "What causes the flow of the electrical current in the electrical circuit?", "opts": ["Resistance", "Wires", "Current", "Voltage"], "a": 3, "why": "Voltage is the electrical pressure that pushes the electrons through the circuit."}, {"id": "el21", "q": "The number of free electrons moving in a conductor is called ____.", "opts": ["Current", "Resistance", "Voltage", "Power"], "a": 0, "why": "Current is the flow (movement) of free electrons in a conductor."}, {"id": "el22", "q": "The sum of the voltage drops in a series circuit equals the ____.", "opts": ["Source voltage", "Wattage", "Ampere", "Resistance"], "a": 0, "why": "In a series circuit, the voltage drops add up to the source voltage."}]}, {"id": "elec_l3", "name": "Complete the sentences", "questions": [{"id": "el23", "q": "An atom is composed of a nucleus and ____.", "opts": ["Voltage", "Energy levels", "Only protons", "Only wires"], "a": 1, "why": "An atom consists of a nucleus and energy levels (orbits) in which electrons move."}, {"id": "el24", "q": "The types of electric current are ____.", "opts": ["High current and Low current", "Alternating current (AC) and Direct current (DC)", "Series current and Parallel current", "Static current and Magnetic current"], "a": 1, "why": "The two types of electric current are AC and DC."}, {"id": "el25", "q": "The current is directly proportional to voltage and inversely proportional to ____.", "opts": ["Length of time", "Power", "Charge", "Resistance"], "a": 3, "why": "Ohm's law: I = V / R."}, {"id": "el26", "q": "Alternating current changes its ____.", "opts": ["Direction and magnitude", "Only magnitude", "Only direction", "Neither direction nor magnitude"], "a": 0, "why": "AC changes both its direction and its magnitude over time."}, {"id": "el27", "q": "Direct current is used in ____ while alternating current is used in ____.", "opts": ["Homes / Cars", "Cars / Homes", "Homes / Homes", "Cars / Cars"], "a": 1, "why": "Cars use DC from the battery; homes use AC from the grid."}, {"id": "el28", "q": "The current passing through R2 is ____.", "opts": ["10.14 A", "3.9 A", "8 A", "1.3 A"], "a": 3, "why": "Value given in the question bank answer key (circuit figure is not included in the file)."}, {"id": "el29", "q": "The voltage across R1 is ____.", "opts": ["3.9 V", "8 V", "10.14 V", "1.3 V"], "a": 1, "why": "Value given in the question bank answer key (circuit figure is not included in the file)."}, {"id": "el30", "q": "The voltage across R2 is ____.", "opts": ["1.3 V", "3.9 V", "8 V", "10.14 V"], "a": 1, "why": "Value given in the question bank answer key (circuit figure is not included in the file)."}, {"id": "el31", "q": "The power across R1 is ____.", "opts": ["8 W", "1.3 W", "3.9 W", "10.14 W"], "a": 3, "why": "Value given in the question bank answer key (circuit figure is not included in the file)."}]}, {"id": "elec_l4", "name": "Circuit problems", "questions": [{"id": "el32", "q": "A 12-volt battery is connected to a series circuit with a resistor of 3 \u03a9. What is the current flowing through the circuit?", "opts": ["4 A", "36 A", "9 A", "0.25 A"], "a": 0, "why": "I = V / R = 12 / 3 = 4 A."}, {"id": "el33", "q": "A 12-volt battery is connected to a series circuit with a resistor, and the current flowing is 12 A. What is the value of the resistor?", "opts": ["1 \u03a9", "12 \u03a9", "144 \u03a9", "0.5 \u03a9"], "a": 0, "why": "R = V / I = 12 / 12 = 1 \u03a9."}, {"id": "el34", "q": "A 12-volt battery is connected to a series circuit with a resistor of 3 \u03a9. What is the electrical power?", "opts": ["4 W", "36 W", "144 W", "48 W"], "a": 3, "why": "I = 12 / 3 = 4 A, then P = V \u00d7 I = 12 \u00d7 4 = 48 W."}, {"id": "el35", "q": "In the circuit shown (R1\u2013R4 are all 4 \u03a9, current = 3 A), what is the total resistance?", "opts": ["8 \u03a9", "4 \u03a9", "16 \u03a9", "2 \u03a9"], "a": 1, "why": "R1+R2 = 8 \u03a9 and R3+R4 = 8 \u03a9 in series; the two 8 \u03a9 branches in parallel give (8\u00d78)/(8+8) = 4 \u03a9.", "img": "elec1"}, {"id": "el36", "q": "In the same circuit (total current = 3 A), what is the source voltage?", "opts": ["24 V", "3 V", "7 V", "12 V"], "a": 3, "why": "V = I \u00d7 R = 3 \u00d7 4 = 12 V.", "img": "elec1"}, {"id": "el37", "q": "In the circuit shown (12 V source; R1 = 2 \u03a9, R2 = 8 \u03a9, R3 = 4 \u03a9, R4 = 4 \u03a9), what is the equivalent resistance of R3 and R4?", "opts": ["8 \u03a9", "2 \u03a9", "4 \u03a9", "16 \u03a9"], "a": 0, "why": "R3 and R4 are in series: 4 + 4 = 8 \u03a9.", "img": "elec2"}, {"id": "el38", "q": "In the same circuit, what is the total resistance of the circuit?", "opts": ["4 \u03a9", "8 \u03a9", "6 \u03a9", "14 \u03a9"], "a": 2, "why": "(R3+R4) = 8 \u03a9 in parallel with R2 = 8 \u03a9 gives 4 \u03a9; adding R1 in series gives 2 + 4 = 6 \u03a9.", "img": "elec2"}, {"id": "el39", "q": "In the same circuit, what is the total current drawn from the 12 V battery?", "opts": ["1 A", "6 A", "2 A", "3 A"], "a": 2, "why": "I = V / R = 12 / 6 = 2 A.", "img": "elec2"}, {"id": "el40", "q": "In the circuit shown (12 V, total current 3 A, R2 = R3 = 4 \u03a9 in parallel), what is the total resistance of the circuit?", "opts": ["2 \u03a9", "36 \u03a9", "4 \u03a9", "6 \u03a9"], "a": 2, "why": "Rt = Vt / It = 12 / 3 = 4 \u03a9.", "img": "elec3"}, {"id": "el41", "q": "In the same circuit, what is the value of R1?", "opts": ["4 \u03a9", "8 \u03a9", "2 \u03a9", "6 \u03a9"], "a": 2, "why": "R2 // R3 = (4\u00d74)/(4+4) = 2 \u03a9. Rt = R1 + 2 = 4, so R1 = 4 \u2212 2 = 2 \u03a9.", "img": "elec3"}, {"id": "el42", "q": "In the same circuit, what is the voltage across R1?", "opts": ["6 V", "3 V", "12 V", "4 V"], "a": 0, "why": "R1 = 2 \u03a9 and R2//R3 = 2 \u03a9 are equal and in series, so each takes half of 12 V = 6 V.", "img": "elec3"}, {"id": "el43", "q": "In the same circuit, what is the voltage across R2 and across R3?", "opts": ["3 V each", "12 V each", "2 V each", "6 V each"], "a": 3, "why": "R2 and R3 are in parallel, so they have the same voltage, which equals the voltage across their equivalent resistance (6 V).", "img": "elec3"}]}]}, {"id": "0w686i8", "name": "ENGINE", "lessons": [{"id": "gzb5ixf", "name": "DESIGN OF THE MOTOR", "questions": [{"id": "dm1", "q": "Which of the following is a main system of a motor vehicle?", "opts": ["Drivetrain", "Suspension", "Electrical system", "All of the above"], "a": 3, "why": "The drivetrain, the suspension and the electrical system are all main systems of a motor vehicle."}, {"id": "dm2", "q": "Which type of engine uses pistons?", "opts": ["Rotary engine", "Reciprocating piston engine", "Electric motor", "Wankel engine"], "a": 1, "why": "A reciprocating piston engine uses pistons that move up and down in cylinders."}, {"id": "dm3", "q": "Which of the following is a component of the drivetrain?", "opts": ["Battery", "Clutch", "Steering", "Radiator"], "a": 1, "why": "The clutch is part of the drivetrain, which carries power from the engine to the wheels."}, {"id": "dm4", "q": "What is the main function of the suspension system?", "opts": ["Generate electrical power", "Reduce vibrations and absorb shocks", "Supply fuel", "Control engine temperature"], "a": 1, "why": "The suspension reduces vibrations and absorbs shocks from the road."}, {"id": "dm5", "q": "Which component is responsible for storing electrical energy?", "opts": ["Starter", "Battery", "Clutch", "Differential"], "a": 1, "why": "The battery stores electrical energy for the vehicle."}, {"id": "dm6", "q": "The cooling system is part of the internal combustion engine.", "opts": ["True", "False"], "a": 0, "why": "The cooling system keeps the engine at its working temperature, so it is part of the internal combustion engine."}, {"id": "dm7", "q": "The steering system is part of the electrical system.", "opts": ["True", "False"], "a": 1, "why": "The steering system controls the direction of the vehicle. It is not part of the electrical system."}, {"id": "dm8", "q": "The differential is a component of the drivetrain.", "opts": ["True", "False"], "a": 0, "why": "The differential is part of the drivetrain. It lets the wheels turn at different speeds."}, {"id": "dm9", "q": "The battery is part of the electrical system.", "opts": ["True", "False"], "a": 0, "why": "The battery is part of the electrical system."}, {"id": "dm10", "q": "The clutch is a component of the suspension system.", "opts": ["True", "False"], "a": 1, "why": "The clutch belongs to the drivetrain, not the suspension system."}]}, {"id": "8nuoyf7", "name": "General Introduction+ Classification of engines", "questions": [{"id": "gi1", "q": "Steam engine is \u2026\u2026\u2026\u2026\u2026\u2026\u2026\u2026\u2026\u2026\u2026..", "opts": ["Internal combustion engine", "Gasoline engine", "External combustion engine", "Diesel engine"], "a": 2, "why": "In a steam engine the fuel burns outside the engine to make steam, so it is an external combustion engine."}, {"id": "gi2", "q": "What are the primary operational units that make up a vehicle?", "opts": ["Engine, Transmission, Chassis, Brakes, and Fuel Tank", "Engine, Drive train, Vehicle body, Suspension, and Electrical system", "Engine, Battery, Wheels, Steering, and Exhaust system", "Power plant, Body frame, Steering gear, Cooling system, and Alternator"], "a": 1, "why": "A vehicle is made up of the engine, drive train, vehicle body, suspension and electrical system."}, {"id": "gi3", "q": "How is energy fundamentally utilized by an engine?", "opts": ["Engines use electricity to produce chemical reactions.", "Engines use motion to create fuel.", "Engines use energy to produce power.", "Engines convert mechanical energy directly into chemical energy"], "a": 2, "why": "An engine uses energy (from the fuel) to produce power."}, {"id": "gi4", "q": "In the chronological energy conversion sequence of an engine, what is the correct flow of energy states?", "opts": ["Heat Energy- Chemical Energy -Mechanical Energy", "Chemical Energy in the fuel - Heat Energy - Mechanical Energy", "Mechanical Energy - Heat Energy-Electrical Energy", "Chemical Energy -Kinetic Energy - Thermal Energy"], "a": 1, "why": "The chemical energy in the fuel becomes heat when it burns, and the heat is then converted into mechanical energy."}, {"id": "gi5", "q": "Gasoline engine is \u2026\u2026\u2026\u2026\u2026\u2026\u2026\u2026\u2026\u2026\u2026\u2026\u2026\u2026\u2026.", "opts": ["Internal combustion engine", "External combustion engine", "Reciprocating engine", "Both A and B"], "a": 0, "why": "A gasoline engine burns its fuel inside the cylinder, so it is an internal combustion engine."}, {"id": "gi6", "q": "All cars use External combustion engine.", "opts": ["True", "False"], "a": 1, "why": "Cars use internal combustion engines. External combustion engines, such as the steam engine, are not used in cars."}, {"id": "gi7", "q": "Number OF Classification of engines", "opts": ["5", "6", "7", "10"], "a": 1, "why": "Engines are classified into 6 main groups."}, {"id": "gi8", "q": "What is the primary function of a spark plug in an internal combustion engine?", "opts": ["To inject fuel directly into the combustion chamber", "To generate an electric spark that ignites the air-fuel mixture", "To regulate the engine's operating temperature", "To convert linear piston motion into rotational force"], "a": 1, "why": "The spark plug produces the electric spark that ignites the air-fuel mixture."}, {"id": "gi9", "q": "Classification of engines according to the system of Cooling?", "opts": ["Spark Ignition Engines", "longitudinally", "Four Stroke", "Water Cooled"], "a": 3, "why": "Engines are classified by cooling system into water-cooled and air-cooled engines."}]}, {"id": "29wahlo", "name": "Engine Operation", "questions": [{"id": "ea1", "q": "On a four-stroke engine, during the compression stroke, which statement is correct?", "opts": ["Pressure will increase but temperature will remain constant.", "Pressure and temperature will remain constant.", "Pressure will remain constant but temperature will increase", "Pressure and temperature will increase in the cylinder"], "a": 3, "why": "Compressing the air-fuel mixture raises both its pressure and its temperature."}, {"id": "ea2", "q": "The burning air-fuel mixture forces the piston down on what stroke?", "opts": ["Intake", "Power", "Compression", "Exhaust"], "a": 1, "why": "The burning mixture pushes the piston down on the power stroke."}, {"id": "ea3", "q": "During the \u2026\u2026\u2026\u2026. stroke the piston moves down sucking air and fuel into cylinder.", "opts": ["Exhaust", "Compression", "Power", "Intake"], "a": 3, "why": "On the intake stroke the piston moves down and draws the air and fuel into the cylinder."}, {"id": "ea4", "q": "Both of valves are closed during the \u2026\u2026\u2026.. Stroke.", "opts": ["Intake", "Compression", "Power", "Both C and B"], "a": 3, "why": "Both valves are closed during the compression stroke and the power stroke."}, {"id": "ea5", "q": "..............stroke the piston moves from BDC to TDC and exhaust valve only is open.", "opts": ["Power", "Compression", "Exhaust", "Intake"], "a": 2, "why": "On the exhaust stroke the piston moves up from BDC to TDC with only the exhaust valve open, pushing the burnt gases out."}, {"id": "ea6", "q": "Technician A says that a crank throw determines the stroke of an engine. Technician B says that the length of the connecting rod determines the stroke of an engine. Which technician is correct?", "opts": ["Technician A only", "Technician B only", "Neither Technician A nor B", "Both Technicians A and B"], "a": 0, "why": "The crank throw (the offset of the crankpin) sets the stroke. The connecting rod length does not."}, {"id": "ea7", "q": "The crank shaft rotates ......... the revolutions of the CAM shaft", "opts": ["Half", "Twice", "Equal", "None of the above"], "a": 1, "why": "The crankshaft turns twice for every one turn of the camshaft."}, {"id": "ea8", "q": "How many revolutions will the camshaft do if the crankshaft rotates 80 times?", "opts": ["100", "80", "160", "40"], "a": 3, "why": "The camshaft turns half as many times as the crankshaft: 80 \u00f7 2 = 40."}, {"id": "ea9", "q": "What is the purpose of valve ports?", "opts": ["To let exhaust gases out of the cylinder", "To let air and gasoline into the cylinder", "To allow the valves to move up and down", "both A and B"], "a": 3, "why": "Valve ports let the exhaust gases out of the cylinder and let the air and fuel into it."}, {"id": "ea10", "q": "\u2026\u2026\u2026\u2026 gives the rotating motion to the crank shaft by converting the reciprocating motion of piston into rotating motion.", "opts": ["Connecting rod", "valve", "camshaft", "cylinder"], "a": 0, "why": "The connecting rod links the piston to the crankshaft and turns the piston's up-and-down motion into rotation."}, {"id": "ea11", "q": "T.D.C is an abbreviation for", "opts": ["Top dead center", "Bottom dead center", "swept volume", "cylinder"], "a": 0, "why": "T.D.C stands for Top Dead Center."}, {"id": "ea12", "q": "Each stroke of the cycle requires that the crankshaft rotates\u2026\u2026\u2026\u2026..Degrees.", "opts": ["90", "360", "180", "720"], "a": 2, "why": "One stroke is a piston move from one end to the other, which is half a crankshaft turn (180\u00b0)."}, {"id": "ea13", "q": "Camshaft rotates \u2026\u2026\u2026\u2026\u2026\u2026\u2026Degrees in one complete cycle.", "opts": ["90", "180", "360", "720"], "a": 2, "why": "A complete cycle takes 720\u00b0 of crankshaft rotation, and the camshaft turns half as much, 360\u00b0."}, {"id": "ea14", "q": "Camshaft rotates \u2026\u2026\u2026\u2026\u2026\u2026\u2026.Degrees each stroke of the cycle.", "opts": ["180", "90", "720", "360"], "a": 1, "why": "Each stroke takes 180\u00b0 of crankshaft rotation, so the camshaft turns half of that, 90\u00b0."}, {"id": "ea15", "q": "The longer the piston stroke, the __________ the amount of air-fuel mixture that can enter the cylinder.", "opts": ["Smaller", "Greater", "Equal", "Zero"], "a": 1, "why": "A longer stroke sweeps a larger volume, so more air-fuel mixture can enter."}, {"id": "ea16", "q": "How can we calculate the angle between power strokes in a four-stroke engine?", "opts": ["360\u00b0 \u00f7 Number of cylinders", "720\u00b0 \u00f7 Number of cylinders", "180\u00b0 \u00f7 Number of cylinders", "90\u00b0 \u00d7 Number of cylinders"], "a": 1, "why": "A four-stroke cycle takes 720\u00b0 of crankshaft rotation, so the angle is 720\u00b0 \u00f7 number of cylinders."}, {"id": "ea17", "q": "The greater the number of cylinders, the __________ the distance between power strokes.", "opts": ["Greater", "Longer", "Shorter", "Unchanged"], "a": 2, "why": "With more cylinders, the power strokes come closer together."}, {"id": "ea18", "q": "If an engine has 8 cylinders, how many degrees does the crankshaft rotate between power strokes?", "opts": ["120\u00b0", "90\u00b0", "720\u00b0", "180\u00b0"], "a": 1, "why": "720\u00b0 \u00f7 8 = 90\u00b0."}]}, {"id": "dwyvlxe", "name": "Engine measurement", "questions": [{"id": "em1", "q": "Engine size is determined by:", "opts": ["Engine weight and fuel type", "Crankshaft speed and engine temperature", "Number of valves and spark plugs", "Number of cylinders, bore, and stroke"], "a": 3, "why": "Engine size depends on the number of cylinders and on the bore and stroke of each cylinder."}, {"id": "em2", "q": "What is the diameter of a cylinder called?", "opts": ["Bore", "Displacement", "Stroke", "Throw"], "a": 0, "why": "The diameter of the cylinder is called the bore."}, {"id": "em3", "q": "What happens when the cylinder bore becomes larger?", "opts": ["Cylinder area increases", "Cylinder area decreases", "Piston stroke becomes zero", "Number of cylinders decreases"], "a": 0, "why": "A larger bore means a larger cylinder diameter, so the cylinder area increases."}, {"id": "em4", "q": "What is the piston stroke?", "opts": ["The cylinder diameter", "The volume of the combustion chamber", "The crankshaft rotation speed", "The distance traveled by the piston"], "a": 3, "why": "The stroke is the distance the piston travels from one end of the cylinder to the other."}, {"id": "em5", "q": "The piston stroke is determined by the:", "opts": ["Fuel injector", "Cylinder head", "Exhaust valve", "Crankshaft throw"], "a": 3, "why": "The crankshaft throw sets how far the piston travels."}, {"id": "em6", "q": "What does engine displacement describe?", "opts": ["The total volume displaced by all pistons", "The total engine operating time", "The total weight of the pistons", "The total fuel inside the tank"], "a": 0, "why": "Engine displacement is the total volume swept by all the pistons."}, {"id": "em7", "q": "Piston displacement occurs as the piston travels from:", "opts": ["BDC to TDC", "The intake valve to the exhaust valve", "The cylinder head to the crankshaft", "TDC to BDC only"], "a": 0, "why": "Piston displacement is the volume swept as the piston travels between BDC and TDC."}, {"id": "em8", "q": "Which formula is used to calculate engine displacement?", "opts": ["Bore \u00d7 Stroke", "2 \u00d7 \u03c0 \u00d7 r \u00d7 Stroke", "\u03c0 \u00d7 r\u00b2 \u00d7 Stroke \u00d7 Number of cylinders", "Force \u00d7 Distance"], "a": 2, "why": "Displacement = \u03c0 \u00d7 r\u00b2 \u00d7 stroke \u00d7 number of cylinders."}, {"id": "em9", "q": "In the engine displacement formula, what does R represent?", "opts": ["Piston stroke", "Cylinder radius", "Number of cylinders", "Cylinder diameter"], "a": 1, "why": "R is the cylinder radius, which is half of the bore."}, {"id": "em10", "q": "If the bore is 40 mm, what is the cylinder radius?", "opts": ["20 mm", "40 mm", "30 mm", "10 mm"], "a": 0, "why": "Radius = bore \u00f7 2 = 40 \u00f7 2 = 20 mm."}, {"id": "em11", "q": "Which formula is used to calculate force on the piston?", "opts": ["Force = Pressure \u00f7 Piston Area", "Force = Pressure \u00d7 Piston Area", "Force = Work \u00f7 Time", "Force = Distance \u00d7 Time"], "a": 1, "why": "Force on the piston = pressure \u00d7 piston area."}, {"id": "em12", "q": "What is the formula for mechanical work?", "opts": ["Work = Force \u00f7 Distance", "Work = Force \u00d7 Distance", "Work = Power \u00d7 Distance", "Work = Pressure \u00d7 Time"], "a": 1, "why": "Work = force \u00d7 distance."}, {"id": "em13", "q": "How is mechanical power calculated?", "opts": ["Work \u00d7 Distance", "Force \u00f7 Area", "Work \u00f7 Time", "Distance \u00f7 Force"], "a": 2, "why": "Power = work \u00f7 time."}, {"id": "em14", "q": "What does engine torque represent?", "opts": ["The speed of the cooling fan", "The total volume of the cylinders", "The temperature of the engine oil", "The turning force at the crankshaft"], "a": 3, "why": "Torque is the turning force produced at the crankshaft."}, {"id": "em15", "q": "What happens when combustion pressure pushes the piston downward?", "opts": ["The cylinder bore becomes smaller", "The piston becomes stationary", "The crankshaft stops rotating", "A rotating force is applied to the crankshaft"], "a": 3, "why": "The downward push on the piston is turned into a rotating force on the crankshaft."}, {"id": "em16", "q": "What is the compression ratio?", "opts": ["Cylinder volume at BDC divided by cylinder volume at TDC", "Number of cylinders divided by engine displacement", "Bore divided by stroke", "Cylinder volume at TDC divided by cylinder volume at BDC"], "a": 0, "why": "Compression ratio = cylinder volume at BDC \u00f7 cylinder volume at TDC."}, {"id": "em17", "q": "An engine has a compression ratio of 8:1. What does this mean?", "opts": ["The engine has eight cylinders", "The piston travels eight millimeters", "The volume at TDC is eight times the volume at BDC", "The volume at BDC is eight times the volume at TDC"], "a": 3, "why": "8:1 means the volume at BDC is eight times the volume at TDC."}, {"id": "em18", "q": "Which piston position represents the maximum cylinder volume?", "opts": ["Mid-stroke", "Bottom Dead Center (BDC)", "Top Dead Center (TDC)", "Valve overlap position"], "a": 1, "why": "The cylinder volume is largest when the piston is at BDC."}, {"id": "em19", "q": "Why should the compression ratio be checked after modifying an engine?", "opts": ["To increase the number of cylinders", "To determine the engine paint color", "To ensure it remains the same as originally designed", "To measure the fuel tank capacity"], "a": 2, "why": "Modifications can change the compression ratio, so it must be checked to make sure it matches the original design."}, {"id": "em20", "q": "An engine has 4 cylinders. Each cylinder has a swept volume of 500 cc. What is the total engine displacement?", "opts": ["2,000 cc", "1,000 cc", "4,000 cc", "500 cc"], "a": 0, "why": "4 \u00d7 500 cc = 2,000 cc."}]}, {"id": "pnmauka", "name": "The Firing order or firing interval", "questions": [{"id": "fo1", "q": "What is the firing order in a multi-cylinder engine?", "opts": ["The sequence of air intake in each cylinder.", "The sequence of power delivery of each cylinder.", "The sequence of exhaust gases leaving the engine.", "The sequence of piston movement."], "a": 1, "why": "The firing order is the sequence in which the cylinders deliver their power strokes."}, {"id": "fo2", "q": "In a gasoline engine, the firing order is achieved by:", "opts": ["Fuel injection", "Spark plugs", "Cooling system", "Lubrication system"], "a": 1, "why": "In a gasoline engine the spark plugs fire in the firing order sequence."}, {"id": "fo3", "q": "In a Diesel engine, the firing order is controlled by:", "opts": ["Spark plugs", "Fuel injection sequence", "Air intake sequence", "Exhaust valves"], "a": 1, "why": "A diesel engine has no spark plugs. The fuel injection sequence sets the firing order."}, {"id": "fo4", "q": "What is the common firing order of a four-cylinder, four-stroke engine?", "opts": ["1-2-3-4", "1-3-4-2", "1-4-2-3", "4-3-2-1"], "a": 1, "why": "1-3-4-2 is a common firing order for a four-cylinder engine (1-2-4-3 is the other common one)."}, {"id": "fo5", "q": "What is the firing interval of a three-cylinder, four-stroke engine?", "opts": ["180\u00b0", "240\u00b0", "120\u00b0", "360\u00b0"], "a": 1, "why": "720\u00b0 \u00f7 3 cylinders = 240\u00b0."}, {"id": "fo6", "q": "What is the firing interval of a five-cylinder, four-stroke engine?", "opts": ["180\u00b0", "120\u00b0", "144\u00b0", "90\u00b0"], "a": 2, "why": "720\u00b0 \u00f7 5 cylinders = 144\u00b0."}, {"id": "fo7", "q": "The firing interval of a four-cylinder, four-stroke engine is:", "opts": ["90\u00b0", "120\u00b0", "180\u00b0", "240\u00b0"], "a": 2, "why": "720\u00b0 \u00f7 4 cylinders = 180\u00b0."}, {"id": "fo8", "q": "Which of the following is a common firing order for a four-cylinder engine?", "opts": ["1-3-4-2", "1-2-3-4", "1-2-4-3", "Both A and C"], "a": 3, "why": "Both 1-3-4-2 and 1-2-4-3 are common firing orders for a four-cylinder engine."}, {"id": "fo9", "q": "The firing order represents the sequence of power delivery of each cylinder.", "opts": ["True", "False"], "a": 0, "why": "The firing order is the order in which the cylinders deliver their power strokes."}, {"id": "fo10", "q": "The firing interval is calculated by dividing 720\u00b0 by the number of cylinders in a four-stroke engine.", "opts": ["True", "False"], "a": 0, "why": "A four-stroke cycle takes 720\u00b0 of crankshaft rotation, so the firing interval is 720\u00b0 \u00f7 number of cylinders."}]}, {"id": "3uf2w93", "name": "Engine construction overview", "questions": [{"id": "ec1", "q": "What material are engine blocks typically constructed from?", "opts": ["Plastic and fiberglass", "Cast iron or aluminum", "Copper and brass", "Titanium and carbon fiber"], "a": 1, "why": "Engine blocks are cast from cast iron (strong, durable) or aluminum alloy (lighter, dissipates heat well)."}, {"id": "ec2", "q": "What is the primary function of the engine block?", "opts": ["To store fuel for the injectors", "To provide the foundation for most engine components and systems", "To cool the exhaust gases before they reach the manifold", "To ignite the air-fuel mixture directly"], "a": 1, "why": "The block is the main structure that holds the cylinders, crankshaft and other components."}, {"id": "ec3", "q": "What component converts the up-and-down motion of the pistons into rotary motion?", "opts": ["Camshaft", "Crankshaft", "Pushrod", "Rocker arm"], "a": 1, "why": "The crankshaft changes the pistons' reciprocating motion into rotary motion."}, {"id": "ec4", "q": "Which part is mounted on top of the engine block to seal the top of the cylinders and house the valves?", "opts": ["Oil pan", "Cylinder head", "Crankcase", "Intake manifold"], "a": 1, "why": "The cylinder head sits on the block, closes the cylinders and houses the valves."}, {"id": "ec5", "q": "What characteristic is NOT required for an engine block?", "opts": ["High rigidity to withstand high pressure", "High conductivity to dissipate heat", "Low coefficient of expansion to resist shrinkage", "High flexibility to bend under load"], "a": 3, "why": "A block must be rigid. Bending under load would distort the cylinders."}, {"id": "ec6", "q": "In larger engines, what is used inside the cylinders so they can be replaced easily in case of wear?", "opts": ["Liners (sleeves)", "Gaskets", "Valve keepers", "Pushrods"], "a": 0, "why": "Replaceable liners (sleeves) let a worn cylinder be restored without replacing the whole block."}, {"id": "ec7", "q": "What type of cylinder liner has coolant in direct contact with its outer surface?", "opts": ["Dry liner", "Wet liner", "Solid liner", "Integral liner"], "a": 1, "why": "A wet liner is surrounded directly by coolant. A dry liner is pressed into the block and does not touch the coolant."}, {"id": "ec8", "q": "What is used at the bottom of a wet sleeve to prevent coolant leakage into the crankcase?", "opts": ["A rubber or copper O-ring", "A paper gasket", "Silicone sealant only", "A steel locking clip"], "a": 0, "why": "Rubber or copper O-rings seal the bottom of a wet sleeve."}, {"id": "ec9", "q": "What is the purpose of a cylinder head gasket?", "opts": ["To supply fuel to the intake manifold", "To seal the cylinder head to the block and prevent gases from escaping", "To filter engine oil before it enters the sump", "To connect the piston to the connecting rod"], "a": 1, "why": "The head gasket seals the joint between head and block, keeping combustion gases, oil and coolant in their passages."}, {"id": "ec10", "q": "Valve guides and seats are machined directly into which engine component?", "opts": ["Oil pan", "Cylinder head", "Crankshaft", "Piston crown"], "a": 1, "why": "Valve guides and seats are in the cylinder head, where the valves are housed."}, {"id": "ec11", "q": "What is the function of the camshaft?", "opts": ["To pump engine oil through the passages", "To open and close the valves at the proper time", "To convert reciprocating motion into rotary motion", "To ignite the air-fuel mixture"], "a": 1, "why": "Cam lobes push the valves open and let springs close them at the right moment."}, {"id": "ec12", "q": "In a 4-stroke engine, how fast does the camshaft rotate relative to the crankshaft?", "opts": ["Twice the speed of the crankshaft", "At the same speed as the crankshaft", "At half the speed of the crankshaft", "At one-quarter the speed of the crankshaft"], "a": 2, "why": "Each valve opens once per two crankshaft revolutions (4 strokes), so the camshaft turns at half crankshaft speed."}, {"id": "ec13", "q": "What does DOHC stand for in engine terminology?", "opts": ["Double Overhead Camshaft", "Direct Oil Hydraulic Control", "Double Optimized Head Cylinder", "Driven Overhead Crankshaft"], "a": 0, "why": "DOHC = Double Overhead Camshaft: two camshafts in the cylinder head."}, {"id": "ec14", "q": "In a pushrod engine (overhead valve engine), where is the camshaft located?", "opts": ["Inside the cylinder head", "Inside the cylinder block", "Inside the oil pan", "Directly attached to the flywheel"], "a": 1, "why": "In a pushrod (cam-in-block) engine the camshaft sits in the block and acts on the valves through lifters, pushrods and rocker arms."}, {"id": "ec15", "q": "Why are intake valves typically larger than exhaust valves?", "opts": ["Intake air is drawn in at a lower speed due to pressure differences, needing more room", "Exhaust gases are heavier and need a smaller opening to speed up", "Intake valves are made of weaker materials that require a larger surface area", "Exhaust valves do not experience high temperatures"], "a": 0, "why": "Intake charge enters under low pressure difference, so a larger opening helps fill the cylinder. Exhaust gases are pushed out under pressure."}, {"id": "ec16", "q": "What holds a valve against its seat when the valve is not being opened?", "opts": ["The piston crown", "A valve spring", "The pushrod", "The oil pressure"], "a": 1, "why": "The valve spring keeps the valve closed against its seat."}, {"id": "ec17", "q": "What components secure the spring retainer to the stem of the valve?", "opts": ["Valve keepers (locks)", "Piston rings", "Main bearing caps", "Core plugs"], "a": 0, "why": "Valve keepers (locks) fit in a groove on the stem and hold the spring retainer in place."}, {"id": "ec18", "q": "What is the name of the top surface of the piston?", "opts": ["Skirt", "Crown", "Web", "Flange"], "a": 1, "why": "The top of the piston, facing the combustion chamber, is the crown."}, {"id": "ec19", "q": "What component makes the connection between the piston and the connecting rod?", "opts": ["Wrist pin (gudgeon pin)", "Camshaft lobe", "Valve guide", "Crankshaft snout"], "a": 0, "why": "The wrist pin (gudgeon pin) joins the piston to the small end of the connecting rod."}, {"id": "ec20", "q": "What is the primary function of piston compression rings?", "opts": ["To scrape excess oil off the cylinder walls", "To seal between the piston and cylinder wall to prevent high-pressure gases from escaping into the crankcase", "To pump coolant through the engine block", "To connect the piston to the flywheel"], "a": 1, "why": "Compression rings seal the combustion chamber. Oil control rings handle the oil."}, {"id": "ec21", "q": "Where are the oil control rings located relative to the compression rings?", "opts": ["Above the compression rings", "Below the compression rings", "Directly inside the wrist pin bushing", "On the crankshaft journal"], "a": 1, "why": "Oil control rings are the lowest rings on the piston, below the compression rings."}, {"id": "ec22", "q": "What connects the piston to the rotating crankshaft and helps convert reciprocating motion to rotary motion?", "opts": ["The intake manifold", "The connecting rod", "The valve spring", "The cylinder liner"], "a": 1, "why": "The connecting rod links the piston to the crankshaft."}, {"id": "ec23", "q": "What is the space in the cylinder located between the cylinder head and the piston face called?", "opts": ["Crankcase", "Combustion chamber", "Oil sump", "Valve guide"], "a": 1, "why": "The combustion chamber is where the air-fuel mixture is compressed and burned."}, {"id": "ec24", "q": "What device delivers electric current from the ignition system to ignite the compressed fuel/air mixture?", "opts": ["Fuel injector", "Spark plug", "Thermostat", "Oil pump"], "a": 1, "why": "The spark plug creates the spark that ignites the mixture in a gasoline engine."}, {"id": "ec25", "q": "What is the function of the exhaust manifold?", "opts": ["To supply the fuel/air mixture to the cylinders", "To collect engine exhaust gases from the cylinders", "To filter debris from incoming air", "To circulate coolant around the cylinders"], "a": 1, "why": "The exhaust manifold gathers exhaust gases from all cylinders and sends them to the exhaust pipe."}, {"id": "ec26", "q": "What is another name for the oil pan located at the bottom of the engine?", "opts": ["Sump", "Shroud", "Header", "Plenum"], "a": 0, "why": "The oil pan is also called the sump. It stores the engine oil."}, {"id": "ec27", "q": "Which valve is exposed to more severe operating conditions and higher temperatures?", "opts": ["Intake valve", "Exhaust valve", "PCV valve", "Thermostat bypass valve"], "a": 1, "why": "Exhaust valves are hit by hot burned gases and are not cooled by incoming charge, so they run much hotter."}, {"id": "ec28", "q": "What is the metal rod in a cam-in-block engine that transfers force from the lifter to the rocker arm called?", "opts": ["Pushrod", "Valve stem", "Crank pin", "Wrist pin"], "a": 0, "why": "The pushrod transmits motion from the lifter to the rocker arm."}, {"id": "ec29", "q": "What type of valve seat is a separate part that is interference-fitted to a counterbore in the cylinder head?", "opts": ["Integral valve seat", "Insert valve seat", "Floating valve seat", "Cast-in valve seat"], "a": 1, "why": "An insert seat is a separate ring pressed into the head. An integral seat is machined in the head itself."}, {"id": "ec30", "q": "What component uses counterweights to help balance the reciprocating weight of the pistons and connecting rods?", "opts": ["Camshaft", "Crankshaft", "Rocker shaft", "Distributor"], "a": 1, "why": "Counterweights on the crankshaft balance the moving weight of the pistons and rods."}]}, {"id": "8gi2xq9", "name": "Working principle of diesel engine", "questions": [{"id": "dw1", "q": "What enters the cylinder during the intake stroke of a diesel engine?", "opts": ["Filtered air", "A mixture of fuel and air", "Diesel fuel only", "Exhaust gas"], "a": 0, "why": "Only filtered air enters the cylinder. The diesel fuel is injected later."}, {"id": "dw2", "q": "What happens to the intake valve during the intake stroke?", "opts": ["It stays closed", "It opens only at the end of the stroke", "It opens", "It opens and closes repeatedly"], "a": 2, "why": "The intake valve opens as the piston passes TDC so that air can enter the cylinder."}, {"id": "dw3", "q": "Why does the exhaust valve stay open for a few degrees at the start of the intake stroke?", "opts": ["To let fresh air out", "To let all the exhaust gases from the previous combustion escape", "To inject the fuel", "To cool the piston"], "a": 1, "why": "It stays open briefly so that all the exhaust gases from the previous combustion event can leave."}, {"id": "dw4", "q": "At the start of the intake stroke, the piston passes:", "opts": ["BDC", "The mid-stroke point", "The injector", "TDC"], "a": 3, "why": "The intake stroke begins when the piston passes TDC (top dead centre)."}, {"id": "dw5", "q": "During the compression stroke, the intake valve:", "opts": ["Closes after the piston passes BDC", "Opens fully", "Stays open until TDC", "Is replaced by the injector"], "a": 0, "why": "After the piston passes BDC, the intake valve closes and the air is trapped and compressed."}, {"id": "dw6", "q": "The piston travels up to which point during the compression stroke?", "opts": ["BDC", "The injector level only", "TDC", "The exhaust port"], "a": 2, "why": "The piston travels up to TDC, which completes the first crankshaft rotation."}, {"id": "dw7", "q": "The compression stroke completes how much of a crankshaft rotation?", "opts": ["Half a rotation only", "The first crankshaft rotation", "The second crankshaft rotation", "No rotation"], "a": 1, "why": "The intake and compression strokes together make up the first crankshaft rotation."}, {"id": "dw8", "q": "When is the diesel fuel injected into the cylinder?", "opts": ["During the intake stroke", "During the exhaust stroke", "When the piston is at BDC", "When the piston nears TDC at the end of compression"], "a": 3, "why": "The injectors spray the diesel fuel into the cylinder as the piston nears TDC on the compression stroke."}, {"id": "dw9", "q": "What injects the diesel fuel into the cylinder?", "opts": ["The injectors", "The carburetor", "The spark plug", "The intake valve"], "a": 0, "why": "The injectors deliver the fuel. A diesel engine has no carburetor."}, {"id": "dw10", "q": "What forces the piston down during the power stroke?", "opts": ["The intake air", "The starter motor", "The expanding gases", "The exhaust valve"], "a": 2, "why": "The burning fuel creates expanding gases that push the piston down and rotate the crankshaft."}, {"id": "dw11", "q": "What does the downward motion of the piston do in the power stroke?", "opts": ["It opens the intake valve", "It rotates the crankshaft", "It injects the fuel", "It filters the air"], "a": 1, "why": "The expanding gases force the piston down, which rotates the crankshaft."}, {"id": "dw12", "q": "What starts to happen when the piston passes BDC at the beginning of the exhaust stroke?", "opts": ["The intake valve opens", "The fuel is injected", "Both valves close", "The exhaust valve opens and the exhaust gases start to flow out"], "a": 3, "why": "The exhaust valve opens as the piston passes BDC and the gases start to flow out."}, {"id": "dw13", "q": "What does the piston do during the exhaust stroke?", "opts": ["It travels up to TDC and pumps the spent gases out", "It travels down to BDC and draws in air", "It stays still", "It compresses fresh air"], "a": 0, "why": "The piston moves up to TDC and pushes the spent gases out of the cylinder."}, {"id": "dw14", "q": "Which is the correct order of the strokes in a diesel engine?", "opts": ["Compression, intake, power, exhaust", "Intake, power, compression, exhaust", "Intake, compression, power, exhaust", "Exhaust, power, intake, compression"], "a": 2, "why": "The four strokes follow the order intake, compression, power (combustion), exhaust."}]}, {"id": "u3tjb48", "name": "Two Stroke Engine\u2019s Operation", "questions": [{"id": "tw1", "q": "In a two-stroke engine, how many strokes of the piston are required to complete the whole sequence of events (suction, compression, power, and exhaust)?", "opts": ["One stroke", "Two strokes", "Three strokes", "Four strokes"], "a": 1, "why": "A two-stroke engine completes the whole sequence in two strokes of the piston."}, {"id": "tw2", "q": "How many complete revolutions of the crankshaft are needed to complete one full sequence of events in a two-stroke engine?", "opts": ["Half a revolution", "One complete revolution", "Two complete revolutions", "Four revolutions"], "a": 1, "why": "Two strokes make one complete crankshaft revolution."}, {"id": "tw3", "q": "Which of the following statements is true regarding valves in a two-stroke engine?", "opts": ["It uses multiple poppet valves for intake and exhaust.", "It uses a single overhead camshaft valve system.", "There is no valve in this type of engine.", "It uses mechanical reed valves exclusively for the exhaust."], "a": 2, "why": "A two-stroke engine has no valves. Ports in the cylinder do the job."}, {"id": "tw4", "q": "How does air movement (charge) take place inside a two-stroke engine?", "opts": ["Through mechanically operated poppet valves", "Through holes called ports in the cylinder", "Through external turbocharger nozzles", "Through variable valve timing tappets"], "a": 1, "why": "The charge moves through holes called ports in the cylinder wall, which the piston covers and uncovers."}, {"id": "tw5", "q": "What condition must the crankcase of the engine satisfy where the crankshaft rotates?", "opts": ["It must be fully open to atmospheric pressure", "It must be water-cooled externally", "It must be air tight", "It must be lubricated by a dry sump pump"], "a": 2, "why": "The crankcase must be air tight so the mixture can be compressed in it."}, {"id": "tw6", "q": "During the first stroke (suction + compression) of a two-stroke engine, what happens when the piston moves up the cylinder?", "opts": ["It uncovers all three ports simultaneously.", "It covers two of the ports: the exhaust port and the transfer port.", "It keeps the inlet port completely sealed at all times.", "It opens the combustion chamber valves."], "a": 1, "why": "Moving up, the piston covers the exhaust port and the transfer port."}, {"id": "tw7", "q": "What is the primary effect of the piston moving up and covering the exhaust and transfer ports during the first stroke?", "opts": ["It exhausts all burnt gases directly into the crankcase.", "It opens the inlet valve for fuel injection.", "It traps a charge of fresh mixture in the cylinder, which is then compressed by further upward movement.", "It creates a vacuum that stops engine rotation."], "a": 2, "why": "With both ports covered, the fresh mixture is trapped and compressed as the piston keeps rising."}, {"id": "tw8", "q": "During the first stroke, as the piston continues moving upward, what additional port is uncovered?", "opts": ["The exhaust port", "The transfer port", "A third port: the cylinder suction port", "The pressure relief port"], "a": 2, "why": "The rising piston uncovers the third port, the suction (inlet) port."}, {"id": "tw9", "q": "What happens as a result of the suction port being uncovered during the upward movement of the piston in the first stroke?", "opts": ["Burnt gases escape into the atmosphere.", "More fresh mixture is drawn through this port into the crankcase.", "Coolant is pumped into the cylinder liner.", "Engine oil is drained from the crankcase."], "a": 1, "why": "The upward movement lowers the pressure in the crankcase, so fresh mixture is drawn in through the suction port."}, {"id": "tw10", "q": "Just before the end of the first stroke, what occurs inside the cylinder?", "opts": ["The mixture in the cylinder is ignited as in the four stroke cycle.", "Water is injected to cool the combustion chamber.", "The exhaust port opens fully to release high pressure.", "The crankcase vents to the outside air."], "a": 0, "why": "Just before the end of the stroke the compressed mixture is ignited, as in the four-stroke cycle."}, {"id": "tw11", "q": "During the second stroke (power + exhaust), what forces the piston to move down the cylinder?", "opts": ["The external flywheel momentum", "The rise in pressure in the cylinder caused by the burning gases", "A mechanical spring return mechanism", "Hydraulic fluid pressure from the crankcase"], "a": 1, "why": "The burning gases raise the pressure in the cylinder and push the piston down."}, {"id": "tw12", "q": "During the downward movement of the piston in the second stroke, which ports are uncovered first?", "opts": ["First the exhaust port and then the transfer port", "First the suction port and then the exhaust port", "The transfer port and suction port simultaneously", "Only the intake port"], "a": 0, "why": "The exhaust port is uncovered first, then the transfer port."}, {"id": "tw13", "q": "What happens to the suction port when the piston goes down during the second stroke?", "opts": ["It remains wide open to draw in more air.", "It connects directly to the exhaust system.", "It covers and closes the suction port, trapping and compressing the mixture drawn into the crankcase during the previous stroke.", "It opens a valve to release crankcase pressure."], "a": 2, "why": "The piston covers the suction port, so the mixture in the crankcase is trapped and compressed by the downward movement."}, {"id": "tw14", "q": "What occurs when the exhaust port is uncovered during the second stroke?", "opts": ["Fresh fuel enters the exhaust pipe directly.", "Burnt gases are allowed to flow out through the exhaust port.", "Oil is pumped into the combustion chamber.", "Atmospheric air is sucked backward into the cylinder."], "a": 1, "why": "Uncovering the exhaust port lets the burnt gases flow out."}, {"id": "tw15", "q": "What happens to the fresh mixture under pressure in the crankcase during the second stroke?", "opts": ["It is vented out through the exhaust system.", "It is ignited immediately in the crankcase.", "It is transferred into the cylinder through the transfer port.", "It is stored in an external fuel reservoir."], "a": 2, "why": "When the transfer port is uncovered, the compressed mixture flows from the crankcase into the cylinder."}, {"id": "tw16", "q": "Based on the engine diagram, where does the mixture enter from before going into the inlet port?", "opts": ["From the exhaust system", "From carburetion device", "Directly from the fuel tank without mixing", "From the water pump cooling system"], "a": 1, "why": "The mixture comes from the carburetion device (carburetor), where air and fuel are mixed."}, {"id": "tw17", "q": "According to the engine component layout, where do gases go after leaving the exhaust port?", "opts": ["To exhaust system", "Back into the crank chamber", "Through the cooling fins", "Into the carburetion device"], "a": 0, "why": "The burnt gases leave the exhaust port and go to the exhaust system."}, {"id": "tw18", "q": "Which component is located at the very top of the cylinder head to ignite the mixture?", "opts": ["Transfer port", "Cylinder liner", "Spark (Spark plug)", "Crank web"], "a": 2, "why": "The spark plug sits at the top of the cylinder head and ignites the mixture."}, {"id": "tw19", "q": "What external feature is built around the upper cylinder section to help dissipate heat?", "opts": ["Crankcase", "Cooling fins", "Crank chamber", "Inlet port"], "a": 1, "why": "Cooling fins around the cylinder help dissipate heat."}, {"id": "tw20", "q": "Which internal engine components are housed directly beneath the piston and cylinder liner according to the diagram?", "opts": ["Cylinder head and spark plug", "Crank chamber, crank web, and crankcase", "Exhaust pipe and muffler", "Carburetor and air filter"], "a": 1, "why": "The crank chamber, crank web and crankcase are below the piston and cylinder liner."}]}, {"id": "si37tn2", "name": "Comparison between two stroke and four stroke engines", "questions": [{"id": "cm1", "q": "How many power strokes occur for every two revolutions of the crankshaft in a four-stroke engine?", "opts": ["One power stroke", "Two power strokes", "Four power strokes", "None"], "a": 0, "why": "A four-stroke engine needs two crankshaft revolutions (720\u00b0) to complete its cycle, giving one power stroke."}, {"id": "cm2", "q": "How many power strokes occur for each revolution of the crankshaft in a two-stroke engine?", "opts": ["Half a power stroke", "One power stroke", "Two power strokes", "Four power strokes"], "a": 1, "why": "A two-stroke engine completes its cycle in one crankshaft revolution, so it has one power stroke per revolution."}, {"id": "cm3", "q": "For the same cylinder volume, how does the power output of a two-stroke engine compare to a four-stroke engine?", "opts": ["Small", "Equal", "Large (about 1.5 times of 4 stroke)", "Half"], "a": 2, "why": "It fires every revolution instead of every two, so it gives about 1.5 times the power of a four-stroke engine of the same size."}, {"id": "cm4", "q": "Which type of engine uses ports instead of valves?", "opts": ["Four-stroke engine", "Two-stroke engine", "Both engines", "Neither engine"], "a": 1, "why": "The two-stroke engine uses ports in the cylinder wall that the piston covers and uncovers."}, {"id": "cm5", "q": "What is the valve mechanism status in a four-stroke engine?", "opts": ["Ports are used instead of valves", "Valve mechanism is absent", "Valve mechanism is present", "Electronic valves only"], "a": 2, "why": "The four-stroke engine has a valve mechanism (camshaft, valves, springs) to open and close the intake and exhaust."}, {"id": "cm6", "q": "How is construction and cost described for a four-stroke engine?", "opts": ["Simple and cheap", "Complicated and expensive", "Simple and expensive", "Complicated and cheap"], "a": 1, "why": "The valve train makes the four-stroke engine complicated and more expensive."}, {"id": "cm7", "q": "Which engine is characterized by a simple construction and low cost?", "opts": ["Four-stroke engine", "Two-stroke engine", "Rotary engine", "Steam engine"], "a": 1, "why": "The two-stroke engine has no valve mechanism, so it is simple and cheap."}, {"id": "cm8", "q": "Which engine has a higher fuel consumption (about 15% more)?", "opts": ["Four-stroke engine", "Two-stroke engine", "Both are equal", "Neither consumes fuel"], "a": 1, "why": "Some fresh mixture escapes with the exhaust in a two-stroke engine, so fuel consumption is about 15% higher."}, {"id": "cm9", "q": "How does fuel consumption compare in a four-stroke engine?", "opts": ["Little", "High", "Excessive", "Moderate"], "a": 0, "why": "The four-stroke engine uses less fuel than a two-stroke engine."}, {"id": "cm10", "q": "In which engine is the removal of exhaust gases considered difficult?", "opts": ["Four-stroke engine", "Two-stroke engine", "Both engines", "Neither engine"], "a": 1, "why": "In a two-stroke engine the exhaust and fresh charge overlap, so clearing the exhaust gases is difficult."}, {"id": "cm11", "q": "How is the durability rated for a four-stroke engine compared to a two-stroke engine?", "opts": ["Poor", "Good", "Moderate", "Equal"], "a": 1, "why": "The four-stroke engine has a separate lubrication circuit and less wear, so its durability is good."}, {"id": "cm12", "q": "Which engine type features low stability of operation?", "opts": ["Four-stroke engine", "Two-stroke engine", "Both engines", "Neither engine"], "a": 1, "why": "The two-stroke engine has low operating stability, especially at low speed."}, {"id": "cm13", "q": "How is lubrication achieved in a two-stroke engine?", "opts": ["Equipped with an independent lubricating oil circuit", "Using fuel, mixed with lubricating oil", "Grease lubrication", "Dry sump lubrication"], "a": 1, "why": "The crankcase is used for the mixture, so the oil is mixed with the fuel."}, {"id": "cm14", "q": "How is oil consumption described for a two-stroke engine?", "opts": ["Little", "None", "Much", "Moderate"], "a": 2, "why": "The oil is burned together with the fuel, so oil consumption is high."}, {"id": "cm15", "q": "Why does a two-stroke engine develop much carbon deposit inside the cylinder?", "opts": ["Due to high temperatures", "Because of mixed fuel (fuel mixed with lubricating oil)", "Due to poor exhaust removal only", "Because of valve leakage"], "a": 1, "why": "The lubricating oil burns with the fuel and leaves carbon deposits."}]}, {"id": "48krdxy", "name": "Comparison between Diesel and gasoline engines", "questions": [{"id": "dg1", "q": "What is the compression ratio range of a diesel engine?", "opts": ["5:1 to 8:1", "14:1 to 22:1", "8:1 to 12:1", "25:1 to 35:1"], "a": 1, "why": "A diesel engine compresses the air much more than a petrol engine, with a ratio of 14:1 to 22:1."}, {"id": "dg2", "q": "What is the compression ratio range of a petrol engine?", "opts": ["14:1 to 22:1", "1:1 to 3:1", "5:1 to 8:1", "10:1 to 14:1"], "a": 2, "why": "A petrol engine has a lower compression ratio of 5:1 to 8:1."}, {"id": "dg3", "q": "Which fuel does a diesel engine use?", "opts": ["Diesel oil", "Petrol (gasoline)", "Kerosene only", "Natural gas only"], "a": 0, "why": "A diesel engine runs on diesel oil. A petrol engine uses petrol (gasoline)."}, {"id": "dg4", "q": "What is sucked into the cylinder during the suction stroke of a diesel engine?", "opts": ["A mixture of fuel and air", "Fuel only", "Exhaust gas", "Only air"], "a": 3, "why": "In a diesel engine only air is sucked in. The fuel is injected later."}, {"id": "dg5", "q": "What is sucked into the cylinder during the suction stroke of a petrol engine?", "opts": ["Only air", "A mixture of fuel and air", "Only fuel", "Only exhaust gas"], "a": 1, "why": "In a petrol engine a mixture of fuel and air is sucked into the cylinder."}, {"id": "dg6", "q": "Which parts does a diesel engine have to deliver the fuel?", "opts": ["Fuel injection pump and injector", "Carburetor and ignition coil", "Spark plug and distributor", "Carburetor and injector"], "a": 0, "why": "A diesel engine has a fuel injection pump and an injector. It has no carburetor."}, {"id": "dg7", "q": "Which parts does a petrol engine use instead of a fuel injection pump and injector?", "opts": ["Glow plug and turbocharger", "Fuel pump and injector", "Carburetor and ignition coil", "Governor and nozzle"], "a": 2, "why": "A petrol engine has no injection pump or injector. It uses a carburetor and an ignition coil."}, {"id": "dg8", "q": "How is the fuel ignited in a diesel engine?", "opts": ["By an electric spark", "By a glow from the exhaust", "By the starter motor", "By the heat of compression"], "a": 3, "why": "Fuel is injected into the combustion chamber, where it burns because of the heat of compression."}, {"id": "dg9", "q": "How is the air-fuel mixture ignited in a petrol engine?", "opts": ["By an electric spark", "By the heat of compression", "By a fuel injector", "By the engine oil"], "a": 0, "why": "The compressed air-fuel mixture is ignited by an electric spark."}, {"id": "dg10", "q": "Which engine has a high engine weight per horsepower?", "opts": ["Petrol engine", "Both are the same", "Diesel engine", "Neither engine"], "a": 2, "why": "The diesel engine is heavier for the power it produces. Its weight per horsepower is high."}, {"id": "dg11", "q": "Which engine has a comparatively low engine weight per horsepower?", "opts": ["Diesel engine", "Petrol engine", "Both are the same", "Neither engine"], "a": 1, "why": "The petrol engine is lighter for the power it produces. Its weight per horsepower is comparatively low."}, {"id": "dg12", "q": "Which engine has a low operating cost?", "opts": ["Petrol engine", "Both have a high cost", "Neither engine", "Diesel engine"], "a": 3, "why": "The diesel engine has a low operating cost. The petrol engine has a high operating cost."}, {"id": "dg13", "q": "Which statement about the petrol engine is correct?", "opts": ["It uses a carburetor and spark ignition, with a lower compression ratio", "It has a high compression ratio and uses a fuel injection pump", "It has a low operating cost and uses diesel oil", "It sucks in only air and ignites the fuel by compression heat"], "a": 0, "why": "The petrol engine uses a carburetor and electric spark ignition, and its compression ratio is lower (5:1 to 8:1)."}, {"id": "dg14", "q": "Which statement about the diesel engine is correct?", "opts": ["It uses a carburetor and an ignition coil", "Its compression ratio is 5:1 to 8:1", "It sucks in only air and injects the fuel at the end of compression", "It has a low engine weight per horsepower"], "a": 2, "why": "The diesel engine sucks in only air and the fuel is injected into the hot compressed air."}]}]}], "imgs": {"img1": "data:image/png;base64,", "img2": "data:image/png;base64,", "img3": "data:image/png;base64,", "img4": "data:image/png;base64,", "img5": "data:image/png;base64,", "img6": "data:image/png;base64,", "elec1": "data:image/png;base64,", "elec2": "data:image/png;base64,", "elec3": "data:image/png;base64,"}}</script>
<script id="app">
const $=s=>document.querySelector(s);
const esc=s=>String(s).replace(/[&<>"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]));
const uid=()=>Math.random().toString(36).slice(2,9);
const LT=['A','B','C','D','E','F'];
const LI={'أ':0,'ا':0,'a':0,'1':0,'ب':1,'b':1,'2':1,'ج':2,'c':2,'3':2,'د':3,'d':3,'4':3};
const IMG=q=>q.img?'<img class="qimg" src="'+((data.imgs&&data.imgs[q.img])||q.img)+'" alt="Question figure">':'';
const IC=['🚗','🔧','🛞','⛽','🔋','🏎️','🚙','🛠️'];
const LG=[['m','Ministry of Education and Technical Education','data:image/png;base64,'],['g','Ghabbour Foundation','data:image/jpeg;base64,'],['s','SIS','data:image/png;base64,']];
const KEY='quiz_teacher_draft';
let data=JSON.parse($('#data').textContent);
let T=false,dirty=false,me=null,S={scr:'login',msg:'',err:''};
const getS=()=>data.subjects.find(x=>x.id===S.sid);
const getL=()=>getS().lessons.find(x=>x.id===S.lid);
const AK='quiz_attempts';
function getAtt(){try{return JSON.parse(localStorage.getItem(AK))||[]}catch(e){return[]}}
function saveAttempt(){
  if(data.saveAns===false||S.saved)return;S.saved=true;
  const rec={d:Date.now(),name:me.name,cls:me.cls,subj:getS().name,topic:getL().name,score:S.score,n:S.qs.length,
    ans:S.qs.map((q,i)=>({q:q.q,c:S.ans[i]===undefined?'':q.opts[S.ans[i]],r:q.opts[q.a],ok:S.ans[i]===q.a}))};
  try{const a=getAtt();a.push(rec);localStorage.setItem(AK,JSON.stringify(a))}catch(e){}
  sendSheet(rec);
}
function ansStr(a){return a.map((x,i)=>(i+1)+'. '+(x.c||'-')+(x.ok?' (correct)':' / '+x.r)).join(' | ')}
function sendSheet(rec){
  const u=(data.sheetUrl||'').trim();if(!u)return;
  const body=JSON.stringify({date:new Date(rec.d).toLocaleString(),name:rec.name,cls:rec.cls,subj:rec.subj,topic:rec.topic,score:rec.score,total:rec.n,percent:Math.round(rec.score/rec.n*100)+'%',answers:ansStr(rec.ans)});
  try{fetch(u,{method:'POST',mode:'no-cors',headers:{'Content-Type':'text/plain;charset=utf-8'},body:body,keepalive:true}).catch(()=>{})}catch(e){}
}
function csvCell(v){return '"'+String(v).replace(/"/g,'""')+'"'}
function dlCsv(){
  const rows=[['Date','Name','Class','Subject','Topic','Score','Total','Percent','Answers (chosen / correct)']];
  getAtt().forEach(r=>rows.push([new Date(r.d).toLocaleString(),r.name,r.cls,r.subj,r.topic,r.score,r.n,Math.round(r.score/r.n*100)+'%',r.ans.map((x,i)=>(i+1)+'. '+(x.c||'-')+(x.ok?' (correct)':' / '+x.r)).join(' | ')]));
  const bl=new Blob(['\ufeff'+rows.map(r=>r.map(csvCell).join(',')).join('\r\n')],{type:'text/csv;charset=utf-8'}),l=document.createElement('a');
  l.href=URL.createObjectURL(bl);l.download='students-results.csv';document.body.appendChild(l);l.click();l.remove();
}
function setDirty(){dirty=true;try{localStorage.setItem(KEY,JSON.stringify(data))}catch(e){}const t=$('#dt');if(t)t.textContent='You have unsaved changes - download an updated copy'}
function render(){
  document.title=data.title;
  let h='<div class="logos">'+LG.map(x=>'<img src="'+x[2]+'" alt="'+x[1]+'">').join('')+'</div><header><h1>🏎️ '+esc(data.title)+'</h1><div class="row" style="margin:0">';
  if(T)h+='<button data-act="exitT">Exit teacher mode</button>';
  else if(me)h+='<span class="muted">'+esc(me.name)+' - '+esc(me.cls)+'</span><button data-act="logout">Log out</button>';
  h+='</div></header>';
  if(T)h+='<div class="bar"><span id="dt">'+(dirty?'You have unsaved changes - download an updated copy':'No new changes')+'</span><button class="pri" data-act="dl">Download updated app</button></div>';
  if(S.msg)h+='<div class="msg">'+esc(S.msg)+'</div>';
  if(S.err)h+='<div class="msg err">'+esc(S.err)+'</div>';
  h+=backBar()+(T?admView():stuView());
  $('#root').innerHTML=h;
  try{if(history.state&&history.state.q===1)history.pushState({q:2},'')}catch(e){}
}
function back(){return ''}
const PARENT={results:'home',pin:'login',subj:'home',lesson:'subj',quiz:'subj',res:'subj'};
const PLAB={login:'Back',home:'Subjects',subj:'Topics'};
function goBack(){if(!PARENT[S.scr])return false;S.scr=PARENT[S.scr];S.msg='';S.err='';S.edit=null;S.bulk=false;S.conf=null;render();return true}
function backBar(){const p=PARENT[S.scr];return p?'<p><button data-act="back">← '+PLAB[p]+'</button></p>':''}
try{history.replaceState({q:1},'');history.pushState({q:2},'')}catch(e){}
window.addEventListener('popstate',()=>{if(!goBack()&&S.scr==='home')render()});
function stuView(){
  let h='';
  if(S.scr==='login'){
    h+='<div class="chk"></div><div class="hero">🚗🔧🛞⛽</div><div class="box login"><h2 style="margin-top:0;text-align:center">Welcome to the Quiz Garage!</h2><label>Student name</label><input id="nm" placeholder="Full name" autocomplete="off"><label>Class</label><input id="cl" placeholder="e.g. 2/3" autocomplete="off"><p><button class="pri" data-act="enter" style="width:100%">Let’s go 🏁</button></p></div>';
    h+='<div class="tl"><button data-act="pinScr">Teacher login</button></div>';
  }else if(S.scr==='pin'){
    h+=back('login','Back')+'<div class="box"><label>Teacher PIN</label><input id="pin" type="password" inputmode="numeric" autocomplete="off"><p><button class="pri" data-act="pinOk">Enter</button></p></div>';
  }else if(S.scr==='home'){
    h+='<h2>Choose a subject</h2>';
    if(!data.subjects.length)h+='<p class="muted">No subjects yet.</p>';
    data.subjects.forEach((s,i)=>h+='<button class="card" data-act="openS" data-id="'+s.id+'"><span><span class="ic">'+IC[i%IC.length]+'</span>'+esc(s.name)+'</span><small>'+s.lessons.length+' topic(s) ›</small></button>');
  }else if(S.scr==='subj'){
    const s=getS();h+=back('home','Subjects')+'<h2>'+esc(s.name)+' - choose a topic</h2>';
    if(!s.lessons.length)h+='<p class="muted">No topics yet.</p>';
    s.lessons.forEach((l,i)=>h+='<button class="card" data-act="start" data-id="'+l.id+'"'+(l.questions.length?'':' disabled')+'><span><span class="ic">'+IC[(i+3)%IC.length]+'</span>'+esc(l.name)+'</span><small>'+l.questions.length+' question(s) ›</small></button>');
  }else if(S.scr==='quiz'){
    const q=S.qs[S.i],n=S.qs.length;
    h+='<div class="muted">Question '+(S.i+1)+' of '+n+'</div><div class="prog"><span class="flag">🏁</span><span class="car" style="left:calc((100% - 34px) * '+(S.i/n)+' + 4px)">🚗</span></div>';
    h+='<div class="box"><div class="q">'+esc(q.q)+'</div>'+IMG(q);
    q.opts.forEach((o,i)=>{let c='o';if(S.sel!==null){if(i===q.a)c+=' ok';else if(i===S.sel)c+=' bad'}
      h+='<button class="'+c+'" data-act="pick" data-i="'+i+'"'+(S.sel!==null?' disabled':'')+'>'+LT[i]+') '+esc(o)+'</button>'});
    if(S.sel!==null){
      h+='<p><b>'+(S.sel===q.a?'Correct ✅ Keep it up!':'Wrong ❌ — correct answer: '+esc(q.opts[q.a]))+'</b></p>';
      if(q.why)h+='<div class="why">'+esc(q.why)+'</div>';
      h+='<button class="pri" data-act="next">'+(S.i+1<n?'Next question':'See result')+'</button>';
    }
    h+='</div>';
  }else if(S.scr==='res'){
    const n=S.qs.length,p=Math.round(S.score/n*100);
    const txt='Student: '+me.name+'\nClass: '+me.cls+'\nSubject: '+getS().name+'\nTopic: '+getL().name+'\nScore: '+S.score+' out of '+n+'\nAnswers: '+S.qs.map((q,i)=>(i+1)+LT[S.ans[i]]+(S.ans[i]===q.a?'✔':'✘(correct '+LT[q.a]+')')).join('  ');
    const ph=(data.phone||'').replace(/\D/g,'');
    const wa='https://wa.me/'+ph+'?text='+encodeURIComponent(txt);
    h+='<div class="chk"></div><div class="box">'+gauge(p)+'<div class="score" dir="ltr">'+S.score+' / '+n+'</div><p style="text-align:center;font-weight:600">'+(p>=85?'🏆 Pro driver!':p>=60?'🚗 Good job! Review your mistakes and try again':'🔧 This topic needs another trip to the garage - review it')+'</p><p style="text-align:center"><a class="btn" href="'+wa+'" target="_blank" rel="noopener">Send result via WhatsApp</a></p>'+(data.saveAns===false?'':'<p class="muted" style="text-align:center;font-size:.85rem;margin:0">✔ Your answers were saved</p>')+'</div>';
    if(S.wrong.length){h+='<h2>Questions you missed</h2>';
      S.wrong.forEach(i=>{const q=S.qs[i];h+='<div class="box"><div class="q">'+esc(q.q)+'</div>'+IMG(q)+'<div>Correct answer: <b>'+esc(q.opts[q.a])+'</b></div>'+(q.why?'<div class="why">'+esc(q.why)+'</div>':'')+'</div>'})}
    h+='<div class="row"><button class="pri" data-act="retry">Retry quiz</button><button data-act="go" data-to="subj">Other topics</button><button data-act="go" data-to="home">Subjects</button></div>';
  }
  return h;
}
function gauge(p){
  const pt=(v,r)=>{const t=(180-v*1.8)*Math.PI/180;return [100+r*Math.cos(t),100-r*Math.sin(t)]};
  const arc=(a,b,c)=>{const x=pt(a,80),y=pt(b,80);return '<path d="M'+x[0].toFixed(1)+' '+x[1].toFixed(1)+' A80 80 0 0 1 '+y[0].toFixed(1)+' '+y[1].toFixed(1)+'" stroke="'+c+'" stroke-width="16" fill="none"/>'};
  const n=pt(p,66);
  return '<svg class="gauge" viewBox="0 0 200 130" role="img" aria-label="Score gauge">'+arc(0,60,'#ef4444')+arc(60,85,'#facc15')+arc(85,100,'#22c55e')+'<line x1="100" y1="100" x2="'+n[0].toFixed(1)+'" y2="'+n[1].toFixed(1)+'" stroke="currentColor" stroke-width="4" stroke-linecap="round"/><circle cx="100" cy="100" r="7" fill="currentColor"/><text x="100" y="126" text-anchor="middle" font-size="13" fill="currentColor">'+p+'%</text></svg>';
}
function delBtn(k,id){const key=k+id;return '<button class="danger" data-act="del" data-k="'+k+'" data-id="'+id+'">'+(S.conf===key?'Confirm delete?':'Delete')+'</button>'}
function admView(){
  let h='';
  if(S.scr==='home'){
    h+='<div class="box"><label>App name</label><input data-bind="title" value="'+esc(data.title)+'"><label>Teacher WhatsApp number to receive results (optional, international format e.g. 201012345678)</label><input data-bind="phone" inputmode="numeric" value="'+esc(data.phone||'')+'"><label>Teacher PIN</label><input data-bind="pin" value="'+esc(data.pin)+'"><label style="display:flex;gap:8px;align-items:center;color:var(--tx)"><input type="checkbox" data-bind="save" style="width:auto"'+(data.saveAns===false?'':' checked')+'> Save students\' answers and results</label><label>Google Sheet link (Apps Script Web App URL) - results are added automatically</label><input data-bind="sheet" dir="ltr" placeholder="https://script.google.com/macros/s/.../exec" value="'+esc(data.sheetUrl||'')+'"><p><button data-act="sheetTest">Send a test row</button></p></div>';
    h+='<div class="row"><button class="pri" data-act="go" data-to="results">📋 Students\' results ('+getAtt().length+')</button></div>';
    h+='<h2>Subjects</h2>';
    data.subjects.forEach(s=>h+='<div class="row"><input data-bind="s:'+s.id+'" value="'+esc(s.name)+'"><button data-act="openS" data-id="'+s.id+'">Topics ›</button>'+delBtn('s',s.id)+'</div>');
    h+='<div class="box"><label>Add a new subject</label><div class="row"><input id="newS" placeholder="e.g. Engine Systems"><button class="pri" data-act="addS">Add</button></div></div>';
    h+='<div class="box muted"><b>Important:</b> when you finish editing, click <b>Download updated app</b>, then upload the new file in place of the old one (or send it to students). Students only see your changes in the new file.</div>';
  }else if(S.scr==='results'){
    const a=getAtt().slice().reverse();
    h+='<h2>Students\' results</h2><div class="box muted">Results are stored on the device the student used (in this browser). To collect results from many devices, students can send them via WhatsApp, or open the app on a shared class device.</div>';
    h+='<div class="row"><button class="pri" data-act="csv"'+(a.length?'':' disabled')+'>Download CSV (Excel)</button><button class="danger" data-act="clr"'+(a.length?'':' disabled')+'>'+(S.conf==='clr'?'Confirm delete all?':'Clear all')+'</button></div>';
    if(!a.length)h+='<p class="muted">No saved results yet.</p>';
    a.forEach(r=>{const p=Math.round(r.score/r.n*100),open=S.det===r.d;
      h+='<div class="box"><div class="row" style="margin:0"><b style="flex:1">'+esc(r.name)+' - '+esc(r.cls)+'</b><b dir="ltr">'+r.score+' / '+r.n+' ('+p+'%)</b></div><div class="muted" style="font-size:.9rem">'+esc(r.subj)+' › '+esc(r.topic)+' · '+esc(new Date(r.d).toLocaleString())+'</div><p style="margin:8px 0 0"><button data-act="det" data-id="'+r.d+'">'+(open?'Hide answers':'Show answers')+'</button></p>';
      if(open)r.ans.forEach((x,i)=>h+='<div class="why"><b>'+(i+1)+'. '+esc(x.q)+'</b><br>Student answer: <b style="color:var(--'+(x.ok?'ok':'bad')+')">'+esc(x.c||'—')+(x.ok?' ✅':' ❌')+'</b>'+(x.ok?'':'<br>Correct answer: <b>'+esc(x.r)+'</b>')+'</div>');
      h+='</div>'});
  }else if(S.scr==='subj'){
    const s=getS();h+=back('home','Subjects')+'<h2>Topics: '+esc(s.name)+'</h2>';
    s.lessons.forEach(l=>h+='<div class="row"><input data-bind="l:'+l.id+'" value="'+esc(l.name)+'"><button data-act="openL" data-id="'+l.id+'">Questions ('+l.questions.length+') ‹</button>'+delBtn('l',l.id)+'</div>');
    h+='<div class="box"><label>Add a new topic</label><div class="row"><input id="newL" placeholder="e.g. Unit 1 - Lesson 1"><button class="pri" data-act="addL">Add</button></div></div>';
  }else if(S.scr==='lesson'){
    const l=getL();h+=back('subj','Topics')+'<h2>Questions: '+esc(l.name)+'</h2>';
    l.questions.forEach((q,i)=>h+='<div class="row"><span style="flex:1">'+(i+1)+'. '+esc(q.q)+'</span><button data-act="editQ" data-id="'+q.id+'">Edit</button>'+delBtn('q',q.id)+'</div>');
    if(!l.questions.length)h+='<p class="muted">No questions yet.</p>';
    if(S.edit){
      const e=S.edit,k=Math.max(4,e.opts.length);
      h+='<div class="box"><label>Question text</label><textarea id="fq">'+esc(e.q)+'</textarea><label>Options (select the correct answer with the circle)</label>';
      for(let i=0;i<k;i++)h+='<div class="opt"><input type="radio" name="fa" value="'+i+'"'+(e.a===i?' checked':'')+'><input class="fo" value="'+esc(e.opts[i]||'')+'" placeholder="Option '+LT[i]+'"></div>';
      h+='<label>Answer explanation (optional)</label><textarea id="fw">'+esc(e.why||'')+'</textarea><div class="row"><button class="pri" data-act="saveQ">Save question</button><button data-act="cancelQ">Cancel</button></div></div>';
    }else if(S.bulk){
      h+='<div class="box"><label>Paste your questions here (one after another, with a blank line between them)</label><pre>What does ABS stand for?\nA) Anti-lock Braking System\nB) Auto Brake Setting\nC) Air Brake System\nD) Axle Balance System\nAnswer: A\nExplanation: optional\n\nNext question...</pre><textarea id="bt" style="min-height:200px"></textarea><div class="row"><button class="pri" data-act="doBulk">Add questions</button><button data-act="cancelQ">Cancel</button></div></div>';
    }else{
      h+='<div class="row"><button class="pri" data-act="newQ">+ New question</button><button data-act="bulk">Paste many questions at once</button></div>';
    }
  }
  return h;
}
function parse(t){
  const out=[];
  t.split(/\n\s*\n/).forEach(b=>{
    const ls=b.split('\n').map(x=>x.trim()).filter(Boolean);let q=[],o=[],a=-1,why='';
    ls.forEach(l=>{let m;
      if(m=l.match(/^(?:الإجابة|الاجابة|الإجابة الصحيحة|answer)\s*[:：]\s*(.+)$/i)){const k=m[1].trim().replace(/[).\s(]/g,'').charAt(0).toLowerCase();if(k in LI)a=LI[k]}
      else if(m=l.match(/^(?:الشرح|التوضيح|explanation|why)\s*[:：]\s*(.+)$/i)){why=m[1]}
      else if(m=l.match(/^\(?([أابجدABCDabcd])\s*[\).\-–]\s*(.+)$/)){o.push(m[2])}
      else if(!o.length){q.push(l)}
    });
    if(q.length&&o.length>=2&&a>=0&&a<o.length)out.push({id:uid(),q:q.join(' '),opts:o,a:a,why:why});
  });
  return out;
}
function build(){
  const j=JSON.stringify(data).replace(/</g,'\\u003c');
  return '<!DOCTYPE html>\n<html lang="en" dir="ltr">\n<head>\n<meta charset="utf-8">\n<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">\n<title>'+esc(data.title)+'</title>\n<style id="css">'+$('#css').textContent+'</style>\n</head>\n<body>\n<div id="root"></div>\n<script type="application/json" id="data">'+j+'<\/script>\n<script id="app">'+$('#app').textContent+'<\/script>\n</body>\n</html>';
}
document.addEventListener('change',ev=>{
  const t=ev.target,b=t.dataset&&t.dataset.bind;if(!b)return;if(b==='save'){data.saveAns=t.checked;setDirty();return}const v=t.value.trim();
  if(b==='title'){data.title=v||'Automotive Quizzes'}
  else if(b==='phone'){data.phone=v}
  else if(b==='sheet'){data.sheetUrl=v}
  else if(b==='pin'){if(v)data.pin=v}
  else{const p=b.split(':'),o=p[0]==='s'?data.subjects.find(x=>x.id===p[1]):getS().lessons.find(x=>x.id===p[1]);if(o&&v)o.name=v}
  setDirty();
});
document.addEventListener('click',ev=>{
  const t=ev.target.closest('[data-act]');if(!t)return;
  const a=t.dataset.act,id=t.dataset.id;
  if(a!=='del'&&a!=='clr')S.conf=null;
  S.err='';
  if(a==='enter'){const n=$('#nm').value.trim(),c=$('#cl').value.trim();
    if(!n||!c){S.err='Please enter your name and class first';render();return}
    me={name:n,cls:c};S.scr='home';S.msg=''}
  else if(a==='logout'){me=null;S={scr:'login',msg:'',err:''}}
  else if(a==='pinScr'){S.scr='pin'}
  else if(a==='pinOk'){
    if($('#pin').value.trim()!==String(data.pin)){S.err='Wrong PIN';render();return}
    try{const d=localStorage.getItem(KEY);if(d){data=JSON.parse(d);dirty=true}}catch(e){}
    T=true;S={scr:'home',msg:'',err:''}}
  else if(a==='exitT'){T=false;S={scr:'login',msg:'',err:''}}
  else if(a==='dl'){
    const bl=new Blob([build()],{type:'text/html'}),l=document.createElement('a');
    l.href=URL.createObjectURL(bl);l.download='quiz-app.html';document.body.appendChild(l);l.click();l.remove();
    try{localStorage.removeItem(KEY)}catch(e){}
    dirty=false;S.msg='New file downloaded (quiz-app.html). Upload it in place of the old one or send it to students.'}
  else if(a==='back'){goBack();return}
  else if(a==='csv'){dlCsv();return}
  else if(a==='sheetTest'){if(!(data.sheetUrl||'').trim()){S.err='Paste the Google Sheet link first'}else{sendSheet({d:Date.now(),name:'TEST',cls:'-',subj:'Test',topic:'Test row',score:1,n:1,ans:[{c:'A',r:'A',ok:true}]});S.msg='Test row sent. Open your sheet and check that it appeared (may take a few seconds).'}}
  else if(a==='det'){S.det=(String(S.det)===id?null:+id)}
  else if(a==='clr'){if(S.conf!=='clr'){S.conf='clr'}else{S.conf=null;try{localStorage.removeItem(AK)}catch(e){}}}
  else if(a==='go'){S.scr=t.dataset.to;S.msg='';S.edit=null;S.bulk=false}
  else if(a==='openS'){S.sid=id;S.scr='subj';S.msg=''}
  else if(a==='openL'){S.lid=id;S.scr='lesson';S.msg=''}
  else if(a==='start'){S.lid=id;S.qs=getL().questions;S.i=0;S.sel=null;S.score=0;S.wrong=[];S.ans=[];S.saved=false;S.scr='quiz'}
  else if(a==='pick'){if(S.sel!==null)return;S.sel=+t.dataset.i;S.ans[S.i]=S.sel;if(S.sel===S.qs[S.i].a)S.score++;else S.wrong.push(S.i)}
  else if(a==='next'){if(S.i+1<S.qs.length){S.i++;S.sel=null}else{S.scr='res';saveAttempt()}}
  else if(a==='retry'){S.i=0;S.sel=null;S.score=0;S.wrong=[];S.ans=[];S.saved=false;S.scr='quiz'}
  else if(a==='addS'){const v=$('#newS').value.trim();if(!v)return;data.subjects.push({id:uid(),name:v,lessons:[]});setDirty()}
  else if(a==='addL'){const v=$('#newL').value.trim();if(!v)return;getS().lessons.push({id:uid(),name:v,questions:[]});setDirty()}
  else if(a==='del'){const k=t.dataset.k,key=k+id;
    if(S.conf!==key){S.conf=key}else{S.conf=null;
      if(k==='s')data.subjects=data.subjects.filter(x=>x.id!==id);
      else if(k==='l'){const s=getS();s.lessons=s.lessons.filter(x=>x.id!==id)}
      else{const l=getL();l.questions=l.questions.filter(x=>x.id!==id)}
      setDirty()}}
  else if(a==='newQ'){S.edit={id:null,q:'',opts:['','','',''],a:0,why:''};S.msg=''}
  else if(a==='editQ'){const q=getL().questions.find(x=>x.id===id);S.edit=JSON.parse(JSON.stringify(q));S.msg=''}
  else if(a==='cancelQ'){S.edit=null;S.bulk=false}
  else if(a==='bulk'){S.bulk=true;S.msg=''}
  else if(a==='saveQ'){
    const q=$('#fq').value.trim(),why=$('#fw').value.trim(),r=document.querySelector('input[name=fa]:checked'),ci=r?+r.value:0;
    const ins=[...document.querySelectorAll('.fo')].map(x=>x.value.trim());
    const opts=[];let na=-1;ins.forEach((v,i)=>{if(v){if(i===ci)na=opts.length;opts.push(v)}});
    if(!q||opts.length<2||na<0){S.err='Write the question and at least two options, and make sure the correct answer is filled in';render();return}
    const l=getL(),obj={id:S.edit.id||uid(),q:q,opts:opts,a:na,why:why};if(S.edit.img)obj.img=S.edit.img;
    if(S.edit.id)l.questions=l.questions.map(x=>x.id===obj.id?obj:x);else l.questions.push(obj);
    S.edit=null;setDirty()}
  else if(a==='doBulk'){const r=parse($('#bt').value);
    if(!r.length){S.err='No questions were recognised. Make sure each question has options and an Answer line, with a blank line between questions';render();return}
    getL().questions.push(...r);S.bulk=false;S.msg='Added '+r.length+' question(s)';setDirty()}
  render();
});
render();
</script>
</body>
</html>